#!/usr/bin/env bash
# Runs the checks that CI runs on the code. Run it before you push.
set -euo pipefail
cd "$(dirname "$0")/.."

# CI installs every tool, so a missing tool there is an error.
# On your machine the check is skipped, and CI still runs it.
skipped=""
has() {
  local tool=$1 install_url=$2
  if command -v "$tool" >/dev/null; then
    return 0
  fi
  if [[ -n "${CI:-}" ]]; then
    echo "error: $tool is not installed. Install it in .github/workflows/ci.yml." >&2
    exit 1
  fi
  echo "Skipped the $tool check because $tool is not installed. To run it here, install it: $install_url" >&2
  skipped="${skipped:+$skipped, }$tool"
  return 1
}

if has shellcheck https://github.com/koalaman/shellcheck#installing; then
  shebang='^#!(/bin/|/usr/bin/env )(sh|bash)([[:space:]]|$)'
  # -f skips the submodules and deleted files that git ls-files also lists.
  git ls-files -z | while IFS= read -r -d '' file; do
    if [[ -f $file ]] && IFS= read -r first_line < "$file" && [[ $first_line =~ $shebang ]]; then
      printf '%s\0' "$file"
    fi
  done | xargs -0 shellcheck -x
fi

if has actionlint https://github.com/rhysd/actionlint/blob/main/docs/install.md; then
  actionlint
fi

if has zizmor https://docs.zizmor.sh/installation/; then
  # zizmor checks actions against GitHub's advisories only when it has a GitHub token,
  # such as GH_TOKEN. CI gives it one.
  zizmor .
fi

# Some tools read one of these files instead of AGENTS.md, as "Change these rules" in AGENTS.md describes.
# The first group can be in any folder, and the second only in the repository's root.
# The names match in any case, because some file systems ignore case.
in_any_folder='(.*/)?(CLAUDE\.md|CLAUDE\.local\.md|AGENTS\.override\.md)'
in_the_root='\.rules|\.cursorrules|\.windsurfrules|\.clinerules(/.*)?|\.github/copilot-instructions\.md|AGENT\.md'
instruction_file="^($in_any_folder|$in_the_root)$"
found_instruction_file=""
shopt -s nocasematch
# git lists the tracked files, and the untracked files that it doesn't ignore.
# -e and -L skip the deleted files that it also lists.
while IFS= read -r -d '' file; do
  if [[ $file =~ $instruction_file && (-e $file || -L $file) ]]; then
    echo "error: $file makes a tool skip AGENTS.md. Move its rules into AGENTS.md or a guide in docs/, and delete the file, as \"Change these rules\" in AGENTS.md describes." >&2
    found_instruction_file=yes
  fi
done < <(git ls-files -z --cached --others --exclude-standard)
shopt -u nocasematch
if [[ -n "$found_instruction_file" ]]; then
  exit 1
fi

# Unfinished work belongs in an issue, not in a comment, as the definition of done in AGENTS.md says.
# The two words are split here, so that the search doesn't match its own lines.
todo="TO""DO"
fixme="FIX""ME"
# -w matches the whole word, and -I skips binary files. Markdown is skipped, because the rules mention the words.
if git grep -n -w -I -e "$todo" -e "$fixme" -- ':!*.md' >&2; then
  echo "error: the lines above hold $todo or $fixme. Open an issue for the unfinished work instead, and remove the note." >&2
  exit 1
fi

# Add the project's formatter check, linter, type checker and tests here.

# scripts/test-check runs this script on copies of the repository. It sets CHECK_UNDER_TEST for those runs,
# so that they don't start it again.
if [[ -z "${CHECK_UNDER_TEST:-}" ]]; then
  scripts/test-check
fi

if [[ -n "$skipped" ]]; then
  echo "The checks that ran passed. These were skipped, and CI runs them: $skipped."
else
  echo "Checks passed."
fi
