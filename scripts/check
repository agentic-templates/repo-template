#!/usr/bin/env bash
# Runs the checks that CI runs on the code. Run it before you push.
set -euo pipefail
cd "$(dirname "$0")/.."

# When the checks pass, the script records the tree of the files it checked, which a hook compares with the files
# of a pull request. It takes the tree before the checks start, so that a file changed during the checks doesn't
# count as checked. If git can't give the tree, the checks still run, and the script fails at the end.
# shellcheck source=scripts/hooks/check-passed.bash
source scripts/hooks/check-passed.bash
checked_tree=$(tree_on_disk) || checked_tree=""

# The repository's settings require each action to be pinned to a full commit SHA, which doesn't show which version
# of the action runs. So a comment after the SHA gives the version, as in "# v5.0.0".
# A version starts with a digit, or with v and a digit.
optional_quote="[\"']?"
# Group 2 holds the action, and group 3 what follows the SHA.
pinned_action="^[[:space:]]*(-[[:space:]]+)?uses:[[:space:]]*$optional_quote([^@[:space:]\"']+)@[0-9a-f]{40}$optional_quote([[:space:]].*)?\$"
version_comment='^[[:space:]]+#[[:space:]]*v?[0-9]'
found_pin_without_version=""
# git grep prints the file, NUL, the line number, NUL and the line, for each line that may pin an action.
while IFS= read -r -d '' file && IFS= read -r -d '' line_number && IFS= read -r line; do
  if [[ ! $line =~ $pinned_action ]]; then
    continue
  fi
  action=${BASH_REMATCH[2]}
  after_sha=${BASH_REMATCH[3]}
  if [[ ! $after_sha =~ $version_comment ]]; then
    echo "error: $file:$line_number pins $action to a commit SHA without a version comment. Write the version that the SHA pins in a comment after it, as in \"# v5.0.0\"." >&2
    found_pin_without_version=yes
  fi
done < <(git grep --null -n -I -E -e 'uses:.*@[0-9a-f]{40}' -- '.github/*.yml' '.github/*.yaml')
if [[ -n "$found_pin_without_version" ]]; then
  exit 1
fi

# CI installs every tool, so a missing tool there is an error.
# On your machine the check is skipped, and CI still runs it.
skipped=""
has() {
  local tool=$1 install_url=$2
  if command -v "$tool" >/dev/null; then
    return 0
  fi
  if [[ -n "${CI:-}" ]]; then
    echo "error: $tool is not installed. Install it in scripts/install-check-tools, or in the step of .github/workflows/ci.yml that installs the project's toolchain." >&2
    exit 1
  fi
  echo "Skipped the $tool check because $tool is not installed. To run it here, install it: $install_url" >&2
  skipped="${skipped:+$skipped, }$tool"
  return 1
}

if has shellcheck https://github.com/koalaman/shellcheck#installing; then
  shebang='^#!(/bin/|/usr/bin/env )(sh|bash)([[:space:]]|$)'
  # -f skips the submodules and deleted files that git ls-files also lists.
  git ls-files -z | while IFS= read -r -d '' file; do
    if [[ -f $file ]] && IFS= read -r first_line < "$file" && [[ $first_line =~ $shebang ]]; then
      printf '%s\0' "$file"
    fi
  done | xargs -0 shellcheck -x
fi

if has actionlint https://github.com/rhysd/actionlint/blob/main/docs/install.md; then
  actionlint
fi

if has zizmor https://docs.zizmor.sh/installation/; then
  # zizmor checks actions against GitHub's advisories only when it has a GitHub token,
  # such as GH_TOKEN. CI gives it one.
  zizmor .
fi

# Some tools read a file with one of these names instead of AGENTS.md.
# shellcheck source=scripts/instruction-file-names
source scripts/instruction-file-names
found_instruction_file=""
shopt -s nocasematch
# git lists the tracked files, and the untracked files that it doesn't ignore.
# -e and -L skip the deleted files that it also lists.
while IFS= read -r -d '' file; do
  if [[ $file =~ $instruction_file && (-e $file || -L $file) ]]; then
    echo "error: $file makes a tool skip AGENTS.md. Move its rules into AGENTS.md or a guide in docs/, and delete the file." >&2
    found_instruction_file=yes
  fi
done < <(git ls-files -z --cached --others --exclude-standard)
shopt -u nocasematch
if [[ -n "$found_instruction_file" ]]; then
  exit 1
fi

# Unfinished work belongs in an issue, not in a comment, as the definition of done in AGENTS.md says.
# The two words are split here, so that the search doesn't match its own lines.
todo="TO""DO"
fixme="FIX""ME"
# -w matches the whole word, and -I skips binary files. Markdown is skipped, because the rules mention the words.
if git grep -n -w -I -e "$todo" -e "$fixme" -- ':!*.md' >&2; then
  echo "error: the lines above hold $todo or $fixme. Open an issue for the unfinished work instead, and remove the note." >&2
  exit 1
fi

# shellcheck source=scripts/text-rules
source scripts/text-rules

# Files that .gitattributes marks as generated or vendored don't count.
not_generated_or_vendored=(
  ':(exclude,attr:linguist-generated)'
  ':(exclude,attr:linguist-generated=true)'
  ':(exclude,attr:linguist-vendored)'
  ':(exclude,attr:linguist-vendored=true)'
)

# Paths into a person's home folder stay out of the files.
found_home_path=""
# git grep prints the file, NUL, the line number, NUL and the line, for each line that may hold such a path.
while IFS= read -r -d '' file && IFS= read -r -d '' line_number && IFS= read -r line; do
  while IFS= read -r path; do
    echo "error: $file:$line_number holds a path into a home folder, $path. Use a path relative to the repository, or ~ or \$HOME." >&2
    found_home_path=yes
  done < <(home_paths_in "$line")
done < <(git grep --null -n -I -E -e "$home_path" -- "${not_generated_or_vendored[@]}")
if [[ -n "$found_home_path" ]]; then
  exit 1
fi

# Prints the lines of a section of a Markdown file, between its "## " heading and the next one: section <file> <heading>
section() {
  local file=$1 heading=$2 line is_in_section=""
  if [[ ! -f $file ]]; then
    return 0
  fi
  while IFS= read -r line || [[ -n $line ]]; do
    if [[ $line == "## "* ]]; then
      is_in_section=""
      if [[ $line == "## $heading" ]]; then
        is_in_section=yes
      fi
    elif [[ -n $is_in_section ]]; then
      printf '%s\n' "$line"
    fi
  done < "$file"
}

# Prints each page that "Read the guides" in AGENTS.md links to, once. A link with an anchor,
# as in docs/planning.md#triage-new-ideas, counts as a link to the page.
# The size check and the check that every guide is linked there both use it, so that they agree on the guides.
linked_guides() {
  section AGENTS.md "Read the guides" | { grep -o '](docs/[^)#]*' || true; } | sed 's/^](//' | sort -u
}

# Instruction files stay small.
# The limits cover every tracked AGENTS.md, and the guides that "Read the guides" in the root AGENTS.md links to.
max_lines=199
max_bytes=24999
max_bytes_on_one_path=31999
advice='Move a procedure that only one kind of request needs into a guide of its own.'
too_big=""

agents_files=()
while IFS= read -r -d '' file; do
  # -f skips the deleted files that git ls-files also lists.
  if [[ -f $file ]]; then
    agents_files+=("$file")
  fi
done < <(git ls-files -z -- AGENTS.md '*/AGENTS.md')

instruction_files=()
if ((${#agents_files[@]} > 0)); then
  instruction_files=("${agents_files[@]}")
fi
while IFS= read -r guide; do
  if [[ -f $guide ]]; then
    instruction_files+=("$guide")
  fi
done < <(linked_guides)

if ((${#instruction_files[@]} > 0)); then
  for file in "${instruction_files[@]}"; do
    lines=$(($(wc -l < "$file")))
    bytes=$(($(wc -c < "$file")))
    if ((lines > max_lines)); then
      echo "error: $file has $lines lines, and the limit is $max_lines. $advice" >&2
      too_big=yes
    fi
    if ((bytes > max_bytes)); then
      echo "error: $file has $bytes bytes, and the limit is $max_bytes. $advice" >&2
      too_big=yes
    fi
  done
fi

# Codex reads the AGENTS.md files from the root down to the folder it works in, up to a size limit for all of them together.
if ((${#agents_files[@]} > 0)); then
  for file in "${agents_files[@]}"; do
    folder=$(dirname "$file")
    bytes_on_path=0
    files_on_path=0
    for other in "${agents_files[@]}"; do
      other_folder=$(dirname "$other")
      if [[ $other_folder == . || $folder == "$other_folder" || $folder == "$other_folder"/* ]]; then
        bytes_on_path=$((bytes_on_path + $(wc -c < "$other")))
        files_on_path=$((files_on_path + 1))
      fi
    done
    if ((files_on_path > 1 && bytes_on_path > max_bytes_on_one_path)); then
      echo "error: the AGENTS.md files from the root down to $folder have $bytes_on_path bytes together, and the limit is $max_bytes_on_one_path. $advice" >&2
      too_big=yes
    fi
  done
fi
if [[ -n "$too_big" ]]; then
  exit 1
fi

# Succeeds if a line of the input is exactly the text: has_line <text>
# With -q, grep would stop reading at the first match. The command that writes to grep could then fail
# on the closed pipe, and pipefail would fail the whole pipeline.
has_line() {
  grep -F -x -- "$1" >/dev/null
}

# Each tracked text file stays at 1,000 lines or fewer, because an agent reads a whole file into its context.
max_file_lines=1000
# The list of files that may be longer, if the project has one. Each line holds a file's path from the repository's root,
# a space and the reason. The errors don't mention the list, because adding a file to it loosens the check,
# which docs/code.md allows only when the issue asks for it.
long_files_list=scripts/long-files

# Succeeds if a file has a lockfile's name: is_lockfile <path>
# A package manager writes each lockfile, so the project can't split one. A project whose lockfile isn't here adds its name.
is_lockfile() {
  case ${1##*/} in
    package-lock.json | pnpm-lock.yaml | yarn.lock | bun.lock | uv.lock | poetry.lock | Pipfile.lock | Cargo.lock | \
      go.sum | Gemfile.lock | composer.lock | pubspec.lock | Package.resolved | mix.lock)
      return 0
      ;;
  esac
  return 1
}

long_file_error=""
listed_files=""
if [[ -f $long_files_list ]]; then
  while read -r path reason || [[ -n $path ]]; do
    # A blank line leaves path empty.
    if [[ -z $path ]]; then
      continue
    fi
    listed_files+=$path$'\n'
    if [[ -z $reason ]]; then
      echo "error: $long_files_list lists $path without a reason. Add a space and the reason after the path." >&2
      long_file_error=yes
    fi
  done < "$long_files_list"
fi

files_over_the_limit=""
# -I skips the files that git counts as binary. The empty pattern matches every line, so -c counts each file's lines.
# git grep prints the file, NUL and the count.
while IFS= read -r -d '' file && IFS= read -r line_count; do
  if ((line_count <= max_file_lines)) || is_lockfile "$file"; then
    continue
  fi
  files_over_the_limit+=$file$'\n'
  if ! has_line "$file" <<<"$listed_files"; then
    echo "error: $file has $line_count lines, and the limit is $max_file_lines. Move a part with its own responsibility into a file of its own." >&2
    long_file_error=yes
  fi
done < <(git grep --null -I -c '' -- "${not_generated_or_vendored[@]}")

while IFS= read -r path; do
  if [[ -n $path ]] && ! has_line "$path" <<<"$files_over_the_limit"; then
    echo "error: $long_files_list lists $path, which scripts/check accepts without the list. Remove its line, or fix the path." >&2
    long_file_error=yes
  fi
done <<<"$listed_files"
if [[ -n "$long_file_error" ]]; then
  exit 1
fi

# Each tracked file that starts with #! is executable in git, because a clone can't run it otherwise,
# and scripts/hooks/before-tool skips a check that isn't executable.
found_mode_error=""
# git ls-files -s prints each file's mode, object and stage, then a tab and its path. A regular file that isn't
# executable has mode 100644. Symlinks and submodules have modes of their own.
while IFS= read -r -d '' entry; do
  file=${entry#*$'\t'}
  if [[ ${entry%% *} != 100644 || ! -f $file ]]; then
    continue
  fi
  first_line=""
  IFS= read -r first_line < "$file" || true
  if [[ $first_line == '#!'* ]]; then
    # The allow rules for chmod in .claude/settings.json match chmod +x only when it runs as a command of its own.
    echo "error: $file starts with #!, and git doesn't record it as executable. Run chmod +x $file as a command of its own, and then commit the change. If git ignores file modes, as it can on Windows, run git update-index --chmod=+x $file instead." >&2
    found_mode_error=yes
  fi
done < <(git ls-files -s -z)
if [[ -n "$found_mode_error" ]]; then
  exit 1
fi

# Each check of the hooks has a test, as the comment at the top of scripts/hooks/before-tool asks,
# because a check that fails on its own error lets every action through, and only its test shows that.
found_untested_check=""
while IFS= read -r -d '' hook_check; do
  if [[ -f $hook_check && ! -f ${hook_check%.check}.test ]]; then
    echo "error: $hook_check has no test. Add ${hook_check%.check}.test, which runs the check through scripts/hooks/before-tool, as the other tests in scripts/hooks/ do." >&2
    found_untested_check=yes
  fi
done < <(git ls-files -z -- 'scripts/hooks/*.check')
if [[ -n "$found_untested_check" ]]; then
  exit 1
fi

# The Markdown files refer to sections by their headings, in quotes. Each name must match a heading in its file,
# so that a renamed or removed section doesn't leave a name that leads nowhere.
# A name is written as "<heading>" in <file>, or as "<heading>" describes or "<heading>" says for a section of its own file.
# <file> is a path from the repository's root, written as AGENTS.md, `docs/planning.md` or [docs/releasing.md](docs/releasing.md).
# In a link, its text names the file. A name with describes or says can also match the label of a field in an issue form.
quoted_name='"([^"]+)"'
markdown_path='([A-Za-z0-9_./-]+\.md)'
named_file="($markdown_path|\`$markdown_path\`|\[$markdown_path]\([^)]*\))"
# Text that matches this names a section.
section_name="$quoted_name (in $named_file|describes|says)"
issue_forms=.github/ISSUE_TEMPLATE

# Prints the text of each heading in a Markdown file, at any level: headings <file>
headings() {
  sed -n 's/^#\{1,6\} //p' "$1"
}

# Prints the label of each field in the issue forms.
form_field_labels() {
  local form
  for form in "$issue_forms"/*; do
    if [[ -f $form ]]; then
      sed -n 's/^[[:space:]]*label:[[:space:]]*//p' "$form"
    fi
  done
}

# Prints each section name in a Markdown file on a line of its own: its line number, the name and the file
# that the name points to, separated by tabs. The file is empty for describes and says: section_names_in <file>
section_names_in() {
  local line line_number=0 rest
  # The test after || also reads a last line that has no line break.
  while IFS= read -r line || [[ -n $line ]]; do
    line_number=$((line_number + 1))
    rest=$line
    while [[ $rest =~ $section_name ]]; do
      # One of the groups 4, 5 and 6 holds the path, as it's written plainly, in backticks or as a link's text.
      printf '%s\t%s\t%s\n' "$line_number" "${BASH_REMATCH[1]}" "${BASH_REMATCH[4]}${BASH_REMATCH[5]}${BASH_REMATCH[6]}"
      rest=${rest#*"${BASH_REMATCH[0]}"}
    done
  done < "$1"
}

# Prints an error and fails if a section name matches nothing:
# check_section_name <Markdown file> <line number> <name> <file that the name points to, or empty for its own file>
check_section_name() {
  local file=$1 line_number=$2 name=$3 target=$4
  if [[ -z $target ]]; then
    if headings "$file" | has_line "$name" || form_field_labels | has_line "$name"; then
      return 0
    fi
    echo "error: $file:$line_number names \"$name\", which matches no heading in $file and no field label in $issue_forms/. Fix the name, or the heading." >&2
    return 1
  fi
  if [[ ! -f $target ]]; then
    echo "error: $file:$line_number names \"$name\" in $target, which doesn't exist. Write the path from the repository's root to the file." >&2
    return 1
  fi
  if ! headings "$target" | has_line "$name"; then
    echo "error: $file:$line_number names \"$name\" in $target, which has no such heading. Fix the name, or the heading." >&2
    return 1
  fi
}

broken_name=""
while IFS= read -r -d '' file; do
  # -f skips the deleted files that git ls-files also lists.
  if [[ ! -f $file ]]; then
    continue
  fi
  while IFS=$'\t' read -r line_number name target; do
    if ! check_section_name "$file" "$line_number" "$name" "$target"; then
      broken_name=yes
    fi
  done < <(section_names_in "$file")
done < <(git ls-files -z -- '*.md')
if [[ -n "$broken_name" ]]; then
  exit 1
fi

# The prose in the Markdown files follows the rules that scripts/text-rules finds.
found_prose_error=""
while IFS= read -r -d '' file; do
  # -f skips the deleted files that git ls-files also lists.
  if [[ ! -f $file ]]; then
    continue
  fi
  while IFS=$'\t' read -r line_number line; do
    # prose_in only replaces parts of a line, and what it puts in their place can't break a rule.
    # So a line that breaks no rule as it is passes, and the check skips prose_in, which is slower.
    if [[ $line != *\;* && ! $line =~ $dash_between_words ]] && ! has_click_here_link "$line"; then
      continue
    fi
    prose=$(prose_in "$line")
    if [[ $prose == *\;* ]]; then
      echo "error: $file:$line_number has a semicolon in prose. Write two sentences, as \"Write clear sentences\" in docs/writing.md says." >&2
      found_prose_error=yes
    fi
    if [[ $prose =~ $dash_between_words ]]; then
      echo "error: $file:$line_number has a dash between words in prose. If it joins two sentences, write two sentences, as \"Write clear sentences\" in docs/writing.md says. Otherwise, replace it with a word, as in \"pages 10 to 20\"." >&2
      found_prose_error=yes
    fi
    if has_click_here_link "$prose"; then
      echo "error: $file:$line_number has a link whose text is \"click here\". Make the link text name the page it opens, as \"Organize a page\" in docs/pages.md says." >&2
      found_prose_error=yes
    fi
  done < <(lines_outside_code_blocks "$file")
done < <(git ls-files -z -- '*.md' "${not_generated_or_vendored[@]}")
if [[ -n "$found_prose_error" ]]; then
  exit 1
fi

# Several files repeat the labels, the commit types, the checks that main requires, the gh version and the guides.
# A file that no longer agrees with the others breaks something without an error, so these checks compare them.
# They report every difference, then fail. They leave out a file that doesn't exist.
files_disagree=""

# Prints an error, and fails the checks once every difference is reported: report_difference <message>
report_difference() {
  echo "error: $1" >&2
  files_disagree=yes
}

# Succeeds if a Markdown file has a section with this heading: has_section <file> <heading>
has_section() {
  [[ -f $1 ]] && has_line "## $2" < "$1"
}

# Prints each line of the first list that the second list doesn't hold: lines_missing_from <list> <other list>
lines_missing_from() {
  local line
  while IFS= read -r line; do
    if [[ -n $line ]] && ! has_line "$line" <<<"$2"; then
      printf '%s\n' "$line"
    fi
  done <<<"$1"
}

# Prints a YAML value without the spaces and the quotes around it, or nothing if it's empty.
yaml_value() {
  local value=$1 trimmed='^[[:space:]]*(.*[^[:space:]])[[:space:]]*$' double_quoted='^"(.*)"$' single_quoted="^'(.*)'$"
  if [[ ! $value =~ $trimmed ]]; then
    return 0
  fi
  value=${BASH_REMATCH[1]}
  if [[ $value =~ $double_quoted || $value =~ $single_quoted ]]; then
    value=${BASH_REMATCH[1]}
  fi
  printf '%s\n' "$value"
}

# Prints the labels in the labels: lists of a YAML file. A list is written as [a, b], as lines that start with "- ",
# or as a string with commas, which issue forms also allow.
yaml_labels() {
  local line value item key_column=""
  local key_pattern='^([[:space:]]*(-[[:space:]]+)?)labels:(.*)$' item_pattern='^([[:space:]]*)-[[:space:]]+(.*)$'
  while IFS= read -r line || [[ -n $line ]]; do
    line=${line%%[[:space:]]#*}
    if [[ $line == "#"* || -z ${line//[[:space:]]/} ]]; then
      continue
    fi
    # The items of a list under labels: are indented at least as far as the key.
    if [[ -n $key_column ]]; then
      if [[ $line =~ $item_pattern ]] && ((${#BASH_REMATCH[1]} >= key_column)); then
        yaml_value "${BASH_REMATCH[2]}"
        continue
      fi
      key_column=""
    fi
    if [[ ! $line =~ $key_pattern ]]; then
      continue
    fi
    value=$(yaml_value "${BASH_REMATCH[3]}")
    if [[ -z $value ]]; then
      key_column=${#BASH_REMATCH[1]}
      continue
    fi
    value=${value#\[}
    value=${value%\]}
    while IFS= read -r item; do
      yaml_value "$item"
    done < <(tr ',' '\n' <<<"$value")
  done < "$1"
}

# Prints the labels that scripts/configure-github creates: the first field of each line between <<'LABELS' and LABELS.
created_labels() {
  local line is_in_list=""
  while IFS= read -r line || [[ -n $line ]]; do
    if [[ $line == *"<<'LABELS'" ]]; then
      is_in_list=yes
    elif [[ $line == LABELS ]]; then
      is_in_list=""
    elif [[ -n $is_in_list ]]; then
      printf '%s\n' "${line%%|*}"
    fi
  done < scripts/configure-github
}

# Prints the types under "Use one of these types" in "Commits" in AGENTS.md: the word in backticks that starts each item.
listed_types() {
  local line is_in_list="" pattern="^[[:space:]]+- \`([^\`]+)\`"
  while IFS= read -r line; do
    if [[ $line == *"Use one of these types"* ]]; then
      is_in_list=yes
    elif [[ -n $is_in_list ]]; then
      if [[ ! $line =~ $pattern ]]; then
        return 0
      fi
      printf '%s\n' "${BASH_REMATCH[1]}"
    fi
  done < <(section AGENTS.md Commits)
}

# shellcheck source=scripts/required-checks
source scripts/required-checks

# Prints the check of each job in a workflow that runs on an event, and nothing for a workflow that doesn't:
# job_checks_on <event> <workflow>
# A job's check has the job's name, or its key when it has no name.
job_checks_on() {
  local line spaces content block="" block_indent="" job_check="" property_indent="" checks="" runs_on_event=""
  local event_pattern="(^|[^[:alnum:]_])$1([^[:alnum:]_]|\$)" job_pattern='^([[:alnum:]_-]+):' name_pattern='^name:(.*)$'
  while IFS= read -r line || [[ -n $line ]]; do
    line=${line%%[[:space:]]#*}
    if [[ $line == "#"* || -z ${line//[[:space:]]/} ]]; then
      continue
    fi
    spaces=${line%%[! ]*}
    content=${line#"$spaces"}
    # A key without indentation, such as on: or jobs:, starts a block. YAML lets on be quoted.
    if [[ -z $spaces ]]; then
      block=${content%%:*}
      block=${block//\"/}
      block=${block//\'/}
      block_indent=""
      if [[ $block == on && ${content#*:} =~ $event_pattern ]]; then
        runs_on_event=yes
      fi
      continue
    fi
    if [[ -z $block_indent ]]; then
      block_indent=${#spaces}
    fi
    if [[ $block == on ]] && ((${#spaces} == block_indent)) && [[ $content =~ $event_pattern ]]; then
      runs_on_event=yes
    elif [[ $block == jobs ]] && ((${#spaces} == block_indent)) && [[ $content =~ $job_pattern ]]; then
      if [[ -n $job_check ]]; then
        checks+=$job_check$'\n'
      fi
      job_check=${BASH_REMATCH[1]}
      property_indent=""
    elif [[ $block == jobs && -n $job_check ]]; then
      # The job's own name is indented less than the names of its steps.
      if [[ -z $property_indent ]]; then
        property_indent=${#spaces}
      fi
      if ((${#spaces} == property_indent)) && [[ $content =~ $name_pattern ]]; then
        job_check=$(yaml_value "${BASH_REMATCH[1]}")
      fi
    fi
  done < "$2"
  if [[ -n $job_check ]]; then
    checks+=$job_check$'\n'
  fi
  if [[ -n $runs_on_event ]]; then
    printf '%s' "$checks"
  fi
}

# Prints the version in the first "<phrase> <version> or later" in a file: gh_version <file> <phrase>
gh_version() {
  local line pattern="(^|[^[:alnum:]])$2 ([0-9]+\.[0-9]+) or later"
  if [[ ! -f $1 ]]; then
    return 0
  fi
  while IFS= read -r line || [[ -n $line ]]; do
    if [[ $line =~ $pattern ]]; then
      printf '%s\n' "${BASH_REMATCH[2]}"
      return 0
    fi
  done < "$1"
}

# Prints the title of a Markdown page: its first line that starts with "# ", without the "# " and the spaces at its end.
page_title() {
  local line
  while IFS= read -r line || [[ -n $line ]]; do
    if [[ $line == "# "* ]]; then
      line=${line#"# "}
      printf '%s\n' "${line%"${line##*[![:space:]]}"}"
      return 0
    fi
  done < "$1"
}

for heading in Labels Commits "Read the guides"; do
  if ! has_section AGENTS.md "$heading"; then
    report_difference "AGENTS.md has no section \"$heading\", and scripts/check compares that section with other files. Add it, with the heading \"## $heading\"."
  fi
done

if has_section AGENTS.md Labels; then
  agents_md_labels=$(section AGENTS.md Labels | { grep -o "\`[^\`]*\`" || true; } | tr -d '`' | sort -u)
  if [[ -f scripts/configure-github ]]; then
    created=$(created_labels)
    while IFS= read -r label; do
      report_difference "\"Labels\" in AGENTS.md names $label, and scripts/configure-github doesn't create it. Add it to scripts/configure-github, or remove it from AGENTS.md."
    done < <(lines_missing_from "$agents_md_labels" "$created")
    while IFS= read -r label; do
      report_difference "scripts/configure-github creates the label $label, and \"Labels\" in AGENTS.md doesn't name it. Add it to AGENTS.md, or remove it from scripts/configure-github."
    done < <(lines_missing_from "$created" "$agents_md_labels")
  fi
  for file in "$issue_forms"/*.yml "$issue_forms"/*.yaml .github/release.yml .github/dependabot.yml; do
    if [[ ! -f $file ]]; then
      continue
    fi
    allowed_labels=$agents_md_labels
    # In release notes, "*" stands for every label.
    if [[ $file == .github/release.yml ]]; then
      allowed_labels+=$'\n*'
    fi
    while IFS= read -r label; do
      report_difference "$file names the label $label, and \"Labels\" in AGENTS.md doesn't name it. Use a label that AGENTS.md names, or add $label to AGENTS.md and scripts/configure-github."
    done < <(lines_missing_from "$(yaml_labels "$file" | sort -u)" "$allowed_labels")
  done
fi

# shellcheck source=scripts/title-types
source scripts/title-types
if has_section AGENTS.md Commits && [[ -f scripts/check-title ]]; then
  agents_md_types=$(listed_types)
  title_check_types=$(allowed_title_types)
  while IFS= read -r type; do
    report_difference "\"Commits\" in AGENTS.md lists the type $type, and the title check in scripts/check-title doesn't allow it. Add it to the types in scripts/check-title, or remove it from AGENTS.md."
  done < <(lines_missing_from "$agents_md_types" "$title_check_types")
  while IFS= read -r type; do
    report_difference "the title check in scripts/check-title allows the type $type, and \"Commits\" in AGENTS.md doesn't list it. Add it to AGENTS.md, or remove it from the types in scripts/check-title."
  done < <(lines_missing_from "$title_check_types" "$agents_md_types")
fi

# A required check that no job reports never passes, so no pull request can merge.
# The merge queue waits for each required check too, and removes the pull request once the check times out.
if [[ -f scripts/configure-github ]]; then
  pull_request_checks=""
  merge_group_checks=""
  # Each line holds a check that a workflow reports on pull_request, a tab and the workflow.
  pull_request_workflows=""
  for workflow in .github/workflows/*.yml .github/workflows/*.yaml; do
    if [[ ! -f $workflow ]]; then
      continue
    fi
    workflow_checks=$(job_checks_on pull_request "$workflow")
    pull_request_checks+=$workflow_checks$'\n'
    while IFS= read -r check; do
      if [[ -n $check ]]; then
        pull_request_workflows+=$check$'\t'$workflow$'\n'
      fi
    done <<<"$workflow_checks"
    merge_group_checks+=$(job_checks_on merge_group "$workflow")$'\n'
  done
  required=$(required_checks)
  job_check_list=$(sed '/^$/d' <<<"$pull_request_checks" | paste -sd ',' - | sed 's/,/, /g')
  while IFS= read -r check; do
    report_difference "scripts/configure-github requires the check $check on main, and no job in a workflow in .github/workflows that runs on pull_request reports it. The jobs in those workflows report: ${job_check_list:-no checks}. Rename a job to $check, or change the check in scripts/configure-github."
  done < <(lines_missing_from "$required" "$pull_request_checks")
  # A check that no job reports on pull_request has the error above already.
  while IFS= read -r check; do
    workflows=""
    while IFS=$'\t' read -r reported_check workflow; do
      if [[ $reported_check == "$check" ]]; then
        workflows+="${workflows:+, }$workflow"
      fi
    done <<<"$pull_request_workflows"
    if [[ -n $workflows ]]; then
      report_difference "scripts/configure-github requires the check $check on main, and no job in a workflow in .github/workflows that runs on merge_group reports it, so the merge queue would remove each pull request once the check times out. Add merge_group: to the on: of the workflow that reports $check on pull_request: $workflows."
    fi
  done < <(lines_missing_from "$required" "$merge_group_checks")
fi

# The hooks read the gh version that the rules need from scripts/minimum-gh-version.
# shellcheck source=scripts/minimum-gh-version
source scripts/minimum-gh-version
if [[ ! ${minimum_gh_version:-} =~ ^[0-9]+\.[0-9]+$ ]]; then
  report_difference "scripts/minimum-gh-version doesn't set minimum_gh_version to a version written as <major>.<minor>, such as 2.98, so the hooks can't compare gh with it. Set it to the gh version that the rules need."
else
  agents_md_gh_version=$(gh_version AGENTS.md gh)
  if [[ -z $agents_md_gh_version ]]; then
    report_difference "AGENTS.md doesn't name the gh version that the rules need, written as \"gh <version> or later\". Add it, with the version in scripts/minimum-gh-version: $minimum_gh_version."
  elif [[ $agents_md_gh_version != "$minimum_gh_version" ]]; then
    report_difference "AGENTS.md asks for gh $agents_md_gh_version, and scripts/minimum-gh-version asks for gh $minimum_gh_version. Use the same version in both."
  fi
  # Setup replaces the template's README with the project's, which may name no gh version.
  readme_gh_version=$(gh_version README.md "GitHub CLI")
  if [[ -n $readme_gh_version && $readme_gh_version != "$minimum_gh_version" ]]; then
    report_difference "README.md asks for the GitHub CLI $readme_gh_version, and scripts/minimum-gh-version asks for gh $minimum_gh_version. Use the same version in both."
  fi
fi

# A guide that "Read the guides" doesn't link to is a guide that no agent reads.
guide_links=$(linked_guides)
# Setup replaces the template's README with the project's, which may have no section "What you get".
readme_docs=""
if has_section README.md "What you get"; then
  readme_docs=$(section README.md "What you get" | { grep -o "\`docs/[^\`]*\`" || true; } | tr -d '`' | sort -u)
fi
for page in docs/*.md; do
  if [[ ! -f $page || $(page_title "$page") != *guide ]]; then
    continue
  fi
  if has_section AGENTS.md "Read the guides" && ! has_line "$page" <<<"$guide_links"; then
    report_difference "\"Read the guides\" in AGENTS.md doesn't link to $page, which is a guide because its title ends in \"guide\". Link to it there, and say when to read it."
  fi
  if has_section README.md "What you get" && ! has_line "$page" <<<"$readme_docs"; then
    report_difference "\"What you get\" in README.md doesn't name $page, which is a guide because its title ends in \"guide\". Name it there, and say what it covers."
  fi
done
while IFS= read -r path; do
  if [[ -n $path && ! -e $path ]]; then
    report_difference "\"Read the guides\" in AGENTS.md links to $path, which doesn't exist. Fix the link, or remove it from AGENTS.md."
  fi
done <<<"$guide_links"
while IFS= read -r path; do
  if [[ -n $path && ! -e $path ]]; then
    report_difference "\"What you get\" in README.md names $path, which doesn't exist. Fix the path, or remove it from README.md."
  fi
done <<<"$readme_docs"

if [[ -n "$files_disagree" ]]; then
  exit 1
fi

# scripts/test-check runs this script on copies of the repository. It sets CHECK_UNDER_TEST for those runs,
# so that they don't start it again. They skip the tests in scripts/ and scripts/hooks/ too, because the copies
# don't change the scripts that those tests run.
if [[ -z "${CHECK_UNDER_TEST:-}" ]]; then
  # Add the project's formatter check, linter, type checker, tests and coverage check here.
  # The copies that scripts/test-check makes skip these checks, because the copies hold only the tracked files.
  # Keep this comment after setup, because a case in scripts/test-check finds the place by it.

  scripts/test-check
  if has jq https://jqlang.org/download/; then
    for hook_test in scripts/hooks/*.test; do
      "$hook_test"
    done
  fi
  # -f skips the pattern itself, which the loop gets when no test matches it.
  for script_test in scripts/*.test; do
    if [[ -f $script_test ]]; then
      "$script_test"
    fi
  done
fi

record=$(pass_record_path)
if [[ -z $checked_tree ]] || ! printf '%s\n' "$checked_tree" > "$record"; then
  echo "error: the checks passed, but scripts/check can't record the pass in $record, and a hook blocks opening a pull request without that record. Fix the error above, and run scripts/check again." >&2
  exit 1
fi

if [[ -n "$skipped" ]]; then
  echo "The checks that ran passed. These were skipped, and CI runs them: $skipped."
else
  echo "Checks passed."
fi
