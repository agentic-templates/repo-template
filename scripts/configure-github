#!/usr/bin/env bash
# Applies this repository's settings on GitHub. GitHub doesn't copy settings
# from a template, so run this once after you create a repository from it.
# Running it again is safe, and it resets any setting changed on GitHub.
set -euo pipefail

repo=$(gh repo view --json nameWithOwner --jq .nameWithOwner)
permission=$(gh repo view --json viewerPermission --jq .viewerPermission)
if [[ "$permission" != "ADMIN" ]]; then
  echo "error: changing the settings of $repo needs admin access, and you have $permission access. Ask a maintainer with admin access to run this script." >&2
  exit 1
fi
visibility=$(gh repo view --json visibility --jq '.visibility | ascii_downcase')
if [[ "$visibility" != "public" ]]; then
  echo "error: $repo is $visibility, and this script works only on public repositories, because GitHub offers some of its settings only for them. Nothing was changed. Make the repository public and run this script again, or apply the settings you need by hand." >&2
  exit 1
fi

echo "Merging: squash only, with the pull request title as the commit subject, and auto-merge allowed"
gh api --method PATCH "repos/$repo" --silent \
  -F allow_squash_merge=true \
  -F allow_merge_commit=false \
  -F allow_rebase_merge=false \
  -f squash_merge_commit_title=PR_TITLE \
  -f squash_merge_commit_message=BLANK \
  -F delete_branch_on_merge=true \
  -F allow_auto_merge=true \
  -F has_wiki=false

echo "Security: Dependabot alerts and fixes, private vulnerability reports, secret scanning"
gh api --method PUT "repos/$repo/vulnerability-alerts" --silent
gh api --method PUT "repos/$repo/automated-security-fixes" --silent
gh api --method PUT "repos/$repo/private-vulnerability-reporting" --silent
gh api --method PATCH "repos/$repo" --silent --input - <<'JSON'
{
  "security_and_analysis": {
    "secret_scanning": {"status": "enabled"},
    "secret_scanning_push_protection": {"status": "enabled"}
  }
}
JSON

echo "Labels: the set that AGENTS.md describes"
# GitHub gives every new repository its default labels, and a template can't change that.
labels=$(gh label list --repo "$repo" --limit 200 --json name --jq '.[].name')
for name in accessibility documentation duplicate 'good first issue' 'help wanted' invalid wontfix; do
  if grep -qxF "$name" <<<"$labels"; then
    gh label delete "$name" --repo "$repo" --yes >/dev/null
  fi
done
# Renaming keeps the label on every issue that already has it.
if grep -qxF enhancement <<<"$labels" && ! grep -qxF feature <<<"$labels"; then
  gh label edit enhancement --repo "$repo" --name feature >/dev/null
fi
if grep -qxF question <<<"$labels" && ! grep -qxF needs-decision <<<"$labels"; then
  gh label edit question --repo "$repo" --name needs-decision >/dev/null
fi
# --force updates the color and description of a label that already exists.
while IFS='|' read -r name color description; do
  gh label create "$name" --repo "$repo" --force --color "$color" --description "$description" >/dev/null
done <<'LABELS'
bug|d73a4a|Something is broken, such as a crash, a wrong result or docs that don't match the product
feature|a2eeef|New or changed behavior or docs that users notice, other than a fix
maintenance|c5def5|Work that users don't notice, such as refactoring, tooling, tests or CI
research|d4c5f9|Something to find out before building, such as whether a library works. Ends in a comment
needs-triage|fbca04|No maintainer has accepted or rejected this yet
needs-breakdown|f9d0c4|Accepted, but too big for one pull request. Split it before building
needs-decision|d876e3|Waiting for a maintainer to answer a question or make a decision
ready|0e8a16|A maintainer wants it built, and it meets the definition of ready. Agents build only these
dependencies|0366d6|Dependabot's version updates
LABELS

echo "Releases: a published release can't be changed"
gh api --method PUT "repos/$repo/immutable-releases" --silent

echo "Actions: read-only token, every action pinned to a commit SHA"
gh api --method PUT "repos/$repo/actions/permissions/workflow" --silent \
  -f default_workflow_permissions=read \
  -F can_approve_pull_request_reviews=false
gh api --method PUT "repos/$repo/actions/permissions" --silent \
  -F enabled=true \
  -f allowed_actions=all \
  -F sha_pinning_required=true

echo "Main: every change arrives through a pull request that passes CI"
# A pull request is the record of a change and CI is the gate, so no approval is required.
# GitHub adds an approval for pull requests that an app opens, such as Dependabot's,
# unless require_extra_approval_for_unattributed_changes is false.
# The required checks are job names in .github/workflows. 15368 is the ID of GitHub Actions,
# so only a workflow can report them. A pull request must include the latest main before it merges,
# because agents build several issues at once, and two changes that pass alone can break main together.
ruleset=$(cat <<'JSON'
{
  "name": "main",
  "target": "branch",
  "enforcement": "active",
  "bypass_actors": [],
  "conditions": {"ref_name": {"include": ["~DEFAULT_BRANCH"], "exclude": []}},
  "rules": [
    {"type": "deletion"},
    {"type": "non_fast_forward"},
    {
      "type": "pull_request",
      "parameters": {
        "required_approving_review_count": 0,
        "dismiss_stale_reviews_on_push": false,
        "require_code_owner_review": false,
        "require_last_push_approval": false,
        "required_review_thread_resolution": false,
        "require_extra_approval_for_unattributed_changes": false,
        "allowed_merge_methods": ["squash"]
      }
    },
    {
      "type": "required_status_checks",
      "parameters": {
        "strict_required_status_checks_policy": true,
        "required_status_checks": [
          {"context": "check", "integration_id": 15368},
          {"context": "title", "integration_id": 15368}
        ]
      }
    }
  ]
}
JSON
)
ruleset_id=$(gh api "repos/$repo/rulesets?includes_parents=false" --jq '.[] | select(.name == "main") | .id')
if [[ -n "$ruleset_id" ]]; then
  gh api --method PUT "repos/$repo/rulesets/$ruleset_id" --silent --input - <<<"$ruleset"
else
  gh api --method POST "repos/$repo/rulesets" --silent --input - <<<"$ruleset"
fi

echo "Done. Review the settings at https://github.com/$repo/settings"
