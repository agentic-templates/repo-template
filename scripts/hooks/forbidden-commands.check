#!/usr/bin/env bash
# Blocks the commands that the rules forbid, with a message that says what to do instead:
# - every gh command while gh is older than scripts/minimum-gh-version says, because the rules' commands need it
# - approving a workflow run with gh api, because the run executes the code of a pull request from outside the project
# - closing one of Dependabot's pull requests, or pushing to a dependabot/ branch, because a maintainer decides what
#   happens to Dependabot's pull requests
# - deleting a pull request's branch with gh pr close, because the next agent that works on its issue starts from it
# - gh issue develop on an issue with needs-triage, because no maintainer has accepted the issue yet
# It asks gh and git about the pull request, the issue or the branch, and allows the command when they fail, such as
# without a network.
# shellcheck source=scripts/hooks/helpers.bash
source "${BASH_SOURCE[0]%/*}/helpers.bash"
# shellcheck source=scripts/minimum-gh-version
source "${BASH_SOURCE[0]%/*}/../minimum-gh-version"

# The flags that take a value, as gh api --help, gh pr close --help, gh issue develop --help and git push -h list them.
api_flags_with_value=" --cache -F --field -H --header --hostname --input -q --jq -X --method -p --preview -f --raw-field -t --template "
close_flags_with_value=" -c --comment -R --repo "
develop_flags_with_value=" -b --base --branch-repo -n --name --worktree -R --repo "
push_flags_with_value=" --repo --recurse-submodules --receive-pack --exec -o --push-option "

check_gh_version() {
  local version_output found
  version_output=$(gh --version 2>/dev/null) || return 0
  found=$(older_gh_version "$version_output")
  if [[ -n $found ]]; then
    block "Blocked: the rules in AGENTS.md need gh $minimum_gh_version or later, and this machine has gh $found. Tell the maintainer, and that https://github.com/cli/cli#installation says how to update it."
  fi
}

check_gh_api() {
  local approval='(^|/)actions/runs/[^/]+/approve/?(\?.*)?$'
  read_arguments 2 "$api_flags_with_value"
  if [[ $argument =~ $approval ]]; then
    block "Blocked: a maintainer decides whether to approve a workflow run, because the run executes the code of a pull request from outside the project. Go on with the other work, and list the run in your report for the maintainer."
  fi
}

# Succeeds if a pull request is one of Dependabot's: is_from_dependabot [<pull request>] [--repo <repository>]
# Without a pull request, gh asks about the current branch's.
is_from_dependabot() {
  local answer
  answer=$(gh pr view "$@" --json author 2>/dev/null) || return 1
  [[ $(jq -r .author.login <<<"$answer") == app/dependabot ]]
}

check_gh_pr_close() {
  local pull_request="this branch's pull request"
  read_arguments 3 "$close_flags_with_value"
  if [[ -n $argument ]]; then
    pull_request="pull request $argument"
  fi
  if is_from_dependabot ${target[@]+"${target[@]}"}; then
    block "Blocked: $pull_request is one of Dependabot's, and a maintainer decides what happens to it. Leave it open, and list it in your report for the maintainer."
  fi
  if has_flag -d --delete-branch --delete-branch=true; then
    block "Blocked: gh pr close with --delete-branch or -d deletes the pull request's branch, and the next agent that works on its issue starts from that branch. Close the pull request without that flag."
  fi
}

check_gh_issue_develop() {
  local answer
  read_arguments 3 "$develop_flags_with_value"
  if [[ -z $argument ]]; then
    return 0
  fi
  answer=$(gh issue view "${target[@]}" --json labels 2>/dev/null) || return 0
  if jq -e 'any(.labels[]; .name == "needs-triage")' >/dev/null <<<"$answer"; then
    block "Blocked: issue $argument has needs-triage, so no maintainer has accepted it yet. If a maintainer asked you to work on it, remove the label with gh issue edit ${target[*]} --remove-label needs-triage, and run the command again. Otherwise, leave the issue for the maintainer to triage."
  fi
}

check_git_push() {
  local i=1 word refspec branch
  local -a folder=(-C "${cwd:-.}") words=() refspecs=(HEAD)
  if [[ ${command_words[0]##*/} != git ]]; then
    return 0
  fi
  # git takes each -C relative to the folder before it, so the hook asks git about the branch in the same folder.
  while [[ ${command_words[i]:-} == -C ]]; do
    folder+=(-C "${command_words[i + 1]:-}")
    i=$((i + 2))
  done
  if [[ ${command_words[i]:-} != push ]]; then
    return 0
  fi
  for ((i = i + 1; i < ${#command_words[@]}; i++)); do
    word=${command_words[i]}
    case $word in
      -*=*) ;;
      -*)
        if [[ $push_flags_with_value == *" $word "* ]]; then
          i=$((i + 1))
        fi
        ;;
      *) words+=("$word") ;;
    esac
  done
  # The first word is the remote, and the words after it are refspecs. Without a refspec, git pushes the current branch.
  if ((${#words[@]} > 1)); then
    refspecs=("${words[@]:1}")
  fi
  for refspec in "${refspecs[@]}"; do
    # A refspec is [+]<source>[:<branch>]. Without a colon, it pushes to the branch with the source's name.
    branch=${refspec#+}
    branch=${branch#*:}
    if [[ $branch == HEAD ]]; then
      branch=$(git "${folder[@]}" symbolic-ref --quiet --short HEAD 2>/dev/null) || continue
    fi
    branch=${branch#refs/heads/}
    if [[ $branch == dependabot/* ]]; then
      block "Blocked: $branch is the branch of one of Dependabot's pull requests, and a maintainer decides what happens to those. Leave the branch as it is, and list the pull request in your report for the maintainer."
    fi
  done
}

check_simple_command() {
  drop_command_prefixes "$@"
  if ((${#command_words[@]} == 0)); then
    return 0
  fi
  check_git_push
  if [[ ${command_words[0]##*/} != gh ]]; then
    return 0
  fi
  check_gh_version
  case "${command_words[1]:-} ${command_words[2]:-}" in
    "api "*) check_gh_api ;;
    "pr close") check_gh_pr_close ;;
    "issue develop") check_gh_issue_develop ;;
  esac
}

read_input
if [[ $tool_name == Bash ]]; then
  for_each_simple_command check_simple_command "$shell_command"
fi
