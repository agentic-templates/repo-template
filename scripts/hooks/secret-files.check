#!/usr/bin/env bash
# Blocks reading a file that holds secrets, because AGENTS.md says never to read them.
# The secret files are .env files other than .env.example, and .config/gh, .ssh, .aws and .netrc in the home folder.
# shellcheck source=scripts/hooks/helpers.bash
source "${BASH_SOURCE[0]%/*}/helpers.bash"

# The commands that read the files named in their arguments. To cover another command, add it here.
reading_commands=(cat less more head tail bat nl od xxd hexdump strings base64 grep rg awk sed cut sort diff cp scp rsync tar source .)

# Prints env for a .env file, home for a secret file in the home folder, and nothing for any other path.
secret_kind() {
  local path=$1 home=${HOME%/} name secret
  # The command's words come as written, so these match ~ and $HOME before the shell expands them.
  # shellcheck disable=SC2016,SC2088
  case $path in
    "~" | '$HOME' | '${HOME}') path=$home ;;
    "~/"*) path=$home/${path#"~/"} ;;
    '$HOME/'*) path=$home/${path#'$HOME/'} ;;
    '${HOME}/'*) path=$home/${path#'${HOME}/'} ;;
  esac
  name=${path##*/}
  if [[ $name == .env || ($name == .env.* && $name != .env.example) ]]; then
    echo env
    return
  fi
  for secret in .config/gh .ssh .aws .netrc; do
    if [[ $path == "$home/$secret" || $path == "$home/$secret/"* ]]; then
      echo home
      return
    fi
  done
}

is_reading_command() {
  local name
  for name in "${reading_commands[@]}"; do
    if [[ $1 == "$name" ]]; then
      return 0
    fi
  done
  return 1
}

block_if_secret() {
  local path=$1 kind
  kind=$(secret_kind "$path")
  if [[ $kind == env ]]; then
    block "Blocked: $path holds secrets, and AGENTS.md says never to read them. .env.example lists the variables."
  elif [[ $kind == home ]]; then
    block "Blocked: $path holds secrets, and AGENTS.md says never to read them."
  fi
}

check_simple_command() {
  local first=0 i word

  # A command that takes its input from a secret file reads it, whatever the command is.
  for ((i = 0; i < ${#redirections[@]}; i += 2)); do
    if [[ ${redirections[i]} =~ ^[0-9]*(\<|\<\>)$ ]]; then
      block_if_secret "${redirections[i + 1]}"
    fi
  done

  # The command's name comes after any sudo, env or NAME=value words.
  local -a words=("$@")
  while ((first < ${#words[@]})); do
    word=${words[first]}
    if [[ $word == sudo || $word == env || $word =~ ^[A-Za-z_][A-Za-z0-9_]*= ]]; then
      first=$((first + 1))
    else
      break
    fi
  done
  if ((first == ${#words[@]})) || ! is_reading_command "${words[first]##*/}"; then
    return 0
  fi

  for ((i = first + 1; i < ${#words[@]}; i++)); do
    word=${words[i]}
    block_if_secret "$word"
    # An option can name the file after an equals sign, such as --file=.env.
    if [[ $word == -*=* ]]; then
      block_if_secret "${word#*=}"
    fi
  done
}

read_input
if [[ $tool_name == Bash ]]; then
  for_each_simple_command check_simple_command "$shell_command"
elif [[ $tool_name == Read ]]; then
  block_if_secret "$file_path"
fi
