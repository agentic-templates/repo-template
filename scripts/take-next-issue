#!/usr/bin/env bash
# Takes the next ready issue that a build run can start: scripts/take-next-issue [<issue to skip>...]
# It considers each ready issue that has exactly one type label, no status label, no assignee and no open sub-issues,
# whose blocking issues are all closed, and for which scripts/pull-request-state prints none or left behind. It skips
# the issues it's given. It assigns the lowest-numbered of them to the current account, and then checks that the issue
# still has ready, because a maintainer may have asked another agent to work on it since the script listed the ready
# issues. If it doesn't, the script removes the assignment and takes the next one.
# It prints one line: the issue's number and the first of these kinds that fits it, or none when no issue fits.
# - research: it has the research label.
# - parent: it has sub-issues, which are all closed.
# - left behind <pull request>: scripts/pull-request-state prints left behind for it.
# - other: none of the above.
# It stops with an error when gh fails. It asks gh about the repository of this checkout, or the one in GH_REPO.
# Step 3 of "Build the ready issues" in docs/building.md runs it.
set -euo pipefail
cd "$(dirname "$0")/.."
# shellcheck source=scripts/issue-labels
source scripts/issue-labels

# Prints an error and stops: stop <message>
stop() {
  echo "error: $1" >&2
  exit 1
}

for skipped_issue in "$@"; do
  if [[ ! $skipped_issue =~ ^[1-9][0-9]*$ ]]; then
    stop "scripts/take-next-issue takes the numbers of the issues to skip, such as 12, and it got \"$skipped_issue\"."
  fi
done

# Prints each ready issue's facts on lines, as fields separated by tabs. The first field says what the line holds:
# - issue <number> <assignees> <sub-issues> <closed sub-issues>, with the number of each
# - label <issue> <name>, for each of the issue's labels
# - blocked-by <issue> <state of the blocking issue>, for each issue that blocks it
# shellcheck disable=SC2016 # $number is a jq variable, which jq expands.
jq_filter='.[] | .number as $number
  | (["issue", $number, (.assignees | length), .subIssuesSummary.total, .subIssuesSummary.completed] | @tsv),
    (.labels[] | ["label", $number, .name] | @tsv),
    (.blockedBy.nodes[] | ["blocked-by", $number, .state] | @tsv)'

# Prints the facts of one kind about an issue, without the kind and the number: facts <kind> <issue> <issue facts>
facts() {
  { grep -- "^$1"$'\t'"$2"$'\t' <<<"$3" || true; } | cut -f 3-
}

# Succeeds if a word is one of the other words: is_one_of <word> [<other word>...]
is_one_of() {
  local word=$1 other
  shift
  for other in "$@"; do
    if [[ $other == "$word" ]]; then
      return 0
    fi
  done
  return 1
}

# Succeeds if a build run can start an issue, judged by everything but its pull requests:
# can_start <issue> <issue facts>
can_start() {
  local issue=$1 issue_facts=$2 label state type_count=0 assignees sub_issues closed_sub_issues
  while IFS= read -r label; do
    if is_one_of "$label" "${status_labels[@]}"; then
      return 1
    fi
    if is_one_of "$label" "${type_labels[@]}"; then
      type_count=$((type_count + 1))
    fi
  done <<<"$(facts label "$issue" "$issue_facts")"
  if ((type_count != 1)); then
    return 1
  fi
  while IFS= read -r state; do
    if [[ -n $state && $state != CLOSED ]]; then
      return 1
    fi
  done <<<"$(facts blocked-by "$issue" "$issue_facts")"
  IFS=$'\t' read -r assignees sub_issues closed_sub_issues <<<"$(facts issue "$issue" "$issue_facts")"
  ((assignees == 0 && sub_issues == closed_sub_issues))
}

# Prints, lowest first, the numbers of the issues that a build run can start, judged by everything but their pull
# requests, leaving out the issues to skip: issues_to_consider <issue facts> [<issue to skip>...]
issues_to_consider() {
  local issue_facts=$1 issue
  shift
  while IFS= read -r issue; do
    if [[ -n $issue ]] && ! is_one_of "$issue" "$@" && can_start "$issue" "$issue_facts"; then
      printf '%s\n' "$issue"
    fi
  done <<<"$(grep $'^issue\t' <<<"$issue_facts" | cut -f 2 | sort -n)"
}

# Prints an issue's kind: kind_of <issue> <issue facts> <what scripts/pull-request-state prints for it>
kind_of() {
  local issue=$1 issue_facts=$2 pull_request_state=$3 labels sub_issues
  labels=$(facts label "$issue" "$issue_facts")
  if grep -qxF research <<<"$labels"; then
    echo research
    return 0
  fi
  sub_issues=$(facts issue "$issue" "$issue_facts" | cut -f 2)
  if ((sub_issues > 0)); then
    echo parent
  elif [[ $pull_request_state == "left behind "* ]]; then
    printf '%s\n' "$pull_request_state"
  else
    echo other
  fi
}

if ! issue_facts=$(gh issue list --label ready --limit 200 --json number,labels,assignees,blockedBy,subIssuesSummary --jq "$jq_filter" 2>&1); then
  stop "can't list the ready issues, because gh failed: $issue_facts"
fi

for issue in $(issues_to_consider "$issue_facts" "$@"); do
  # scripts/pull-request-state prints its own error.
  if ! pull_request_state=$(scripts/pull-request-state "$issue"); then
    exit 1
  fi
  if [[ $pull_request_state != none && $pull_request_state != "left behind "* ]]; then
    continue
  fi
  if ! answer=$(gh issue edit "$issue" --add-assignee @me 2>&1); then
    stop "can't assign issue #$issue to you, because gh failed: $answer"
  fi
  if ! labels=$(gh issue view "$issue" --json labels --jq '.labels[].name' 2>&1); then
    stop "assigned issue #$issue to you, but can't check that it still has ready, because gh failed: $labels. Remove your assignment with gh issue edit $issue --remove-assignee @me, and run scripts/take-next-issue again."
  fi
  if ! grep -qxF ready <<<"$labels"; then
    if ! answer=$(gh issue edit "$issue" --remove-assignee @me 2>&1); then
      stop "assigned issue #$issue to you, and it no longer has ready, but can't remove your assignment, because gh failed: $answer. Remove it with gh issue edit $issue --remove-assignee @me, and run scripts/take-next-issue again."
    fi
    continue
  fi
  echo "$issue $(kind_of "$issue" "$issue_facts" "$pull_request_state")"
  exit 0
done
echo none
