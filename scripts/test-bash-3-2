#!/usr/bin/env bash
# Runs the three test groups together. Running them in sequence took 10m14s in CI run 38080017684,
# above the ten-minute limit. Each group's output stays together, and a failure in any group fails the job.
set -euo pipefail
cd "$(dirname "$0")/.."

outputs=$(mktemp -d)
stop_tests() {
  local process_id
  for process_id in $(jobs -pr); do
    kill "$process_id" 2>/dev/null || true
  done
  rm -rf "$outputs"
}
trap stop_tests EXIT

process_ids=()
bash scripts/test-hooks >"$outputs/0.out" 2>"$outputs/0.err" &
process_ids+=("$!")
bash scripts/test-check >"$outputs/1.out" 2>"$outputs/1.err" &
process_ids+=("$!")
(
  for script_test in scripts/*.test; do
    if [[ -f $script_test ]]; then
      bash "$script_test"
    fi
  done
) >"$outputs/2.out" 2>"$outputs/2.err" &
process_ids+=("$!")

status=0
for ((index = 0; index < ${#process_ids[@]}; index++)); do
  if wait "${process_ids[index]}"; then
    test_status=0
  else
    test_status=$?
  fi
  if ((status == 0 && test_status != 0)); then
    status=$test_status
  fi
  cat "$outputs/$index.out"
  cat "$outputs/$index.err" >&2
done
stop_tests
trap - EXIT
exit "$status"
