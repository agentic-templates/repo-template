#!/usr/bin/env bash
# Tests scripts/check. Each case runs it on a copy of the repository. scripts/check runs this script.
set -euo pipefail
cd "$(dirname "$0")/.."

copy=""
failed_cases=0
case_count=0

remove_copy() {
  if [[ -n "$copy" ]]; then
    rm -rf "$copy"
  fi
}
trap remove_copy EXIT

# Copies the tracked files, as they are on disk, into a new git repository at $copy.
make_copy() {
  remove_copy
  copy=$(mktemp -d)
  # -f skips the submodules and deleted files that git ls-files also lists.
  git ls-files -z | while IFS= read -r -d '' file; do
    if [[ -f $file ]]; then
      mkdir -p "$copy/$(dirname "$file")"
      cp -p "$file" "$copy/$file"
    fi
  done
  git -C "$copy" init --quiet
}

# Runs one case: run_case <function> <pass or fail> [<text that the output must hold>]
# The function gets a fresh copy at $copy, and adds the files that the case needs to it.
# Use only checks that need no extra tool, so that a case gives the same result on every machine.
run_case() {
  local case_function=$1 expected=$2 expected_text=${3:-}
  local output actual=pass
  case_count=$((case_count + 1))
  make_copy
  "$case_function"
  git -C "$copy" add --all
  # CHECK_UNDER_TEST stops the copy's scripts/check from running this script again.
  if ! output=$(cd "$copy" && CHECK_UNDER_TEST=1 scripts/check 2>&1); then
    actual=fail
  fi

  if [[ $actual != "$expected" ]]; then
    echo "error: in the case $case_function, scripts/check must $expected, but the result was: $actual. Its output:" >&2
    printf '%s\n' "$output" >&2
    failed_cases=$((failed_cases + 1))
    return
  fi
  if [[ -n "$expected_text" && "$output" != *"$expected_text"* ]]; then
    echo "error: in the case $case_function, the output of scripts/check must hold \"$expected_text\". Its output:" >&2
    printf '%s\n' "$output" >&2
    failed_cases=$((failed_cases + 1))
  fi
}

repository_as_it_is() {
  :
}

run_case repository_as_it_is pass

# Cases for the check that finds files that make a tool skip AGENTS.md.

claude_md_in_the_root() {
  echo "Rules" > "$copy/CLAUDE.md"
}

claude_md_in_a_folder_in_lower_case() {
  echo "Rules" > "$copy/docs/claude.md"
}

file_in_a_clinerules_folder() {
  mkdir "$copy/.clinerules"
  echo "Rules" > "$copy/.clinerules/style.md"
}

two_instruction_files() {
  echo "Rules" > "$copy/.cursorrules"
  echo "Rules" > "$copy/AGENTS.override.md"
}

root_only_name_in_a_folder() {
  echo "Notes" > "$copy/docs/AGENT.md"
}

run_case claude_md_in_the_root fail "error: CLAUDE.md makes a tool skip AGENTS.md."
run_case claude_md_in_a_folder_in_lower_case fail "error: docs/claude.md makes a tool skip AGENTS.md."
run_case file_in_a_clinerules_folder fail "error: .clinerules/style.md makes a tool skip AGENTS.md."
run_case two_instruction_files fail "error: .cursorrules makes a tool skip AGENTS.md."
run_case two_instruction_files fail "error: AGENTS.override.md makes a tool skip AGENTS.md."
run_case root_only_name_in_a_folder pass

# Cases for the check that finds notes about unfinished work.
# The two words are split here, so that the check doesn't match this file.
todo="TO""DO"
fixme="FIX""ME"

todo_in_a_shell_script() {
  printf '%s\n' '#!/usr/bin/env bash' 'echo "start"' "# $todo: print the total" > "$copy/scripts/unfinished"
}

fixme_in_a_text_file() {
  echo "$fixme the rounding" > "$copy/notes.txt"
}

other_words_and_markdown() {
  echo "todo, ${todo}S and MY_$todo are other words" > "$copy/notes.txt"
  echo "$todo: write this page" > "$copy/docs/page.md"
}

run_case todo_in_a_shell_script fail "scripts/unfinished:3:# $todo: print the total"
run_case todo_in_a_shell_script fail "error: the lines above hold $todo or $fixme."
run_case fixme_in_a_text_file fail "notes.txt:1:$fixme the rounding"
run_case other_words_and_markdown pass

# Cases for the check that limits the size of instruction files.

# Writes a file: write_lines <file> <lines> <bytes in each line, with its line ending>
write_lines() {
  local file=$1 lines=$2 bytes=$3 line
  line=$(printf '%*s' $((bytes - 1)) '' | tr ' ' x)
  mkdir -p "$(dirname "$file")"
  for ((written = 0; written < lines; written++)); do
    printf '%s\n' "$line"
  done > "$file"
}

# Adds a line of x's to the end of a file in the copy, so that the file has the given number of bytes:
# pad_to <path in the copy> <bytes>
pad_to() {
  local file=$1 bytes=$2 missing
  missing=$((bytes - $(wc -c < "$copy/$file")))
  if ((missing < 1)); then
    echo "error: $file has $bytes bytes or more, so scripts/test-check can't pad it to $bytes. Raise that size in each case that pads it, and lower the sizes of the other files in the case by as much." >&2
    exit 1
  fi
  printf '%s\n' "$(printf '%*s' $((missing - 1)) '' | tr ' ' x)" >> "$copy/$file"
}

agents_md_of_200_lines() {
  write_lines "$copy/src/AGENTS.md" 200 10
}

agents_md_of_199_lines() {
  write_lines "$copy/src/AGENTS.md" 199 10
}

guide_of_25000_bytes() {
  write_lines "$copy/docs/writing.md" 100 250
}

guide_of_24999_bytes() {
  write_lines "$copy/docs/writing.md" 99 250
  printf '%s\n' "$(printf '%248s' '' | tr ' ' x)" >> "$copy/docs/writing.md"
}

long_page_that_is_no_guide() {
  write_lines "$copy/docs/notes.md" 300 100
}

agents_md_files_of_32000_bytes_on_one_path() {
  pad_to AGENTS.md 20000
  write_lines "$copy/src/api/AGENTS.md" 100 120
}

agents_md_files_of_32000_bytes_on_two_paths() {
  pad_to AGENTS.md 20000
  write_lines "$copy/src/AGENTS.md" 100 60
  write_lines "$copy/lib/AGENTS.md" 100 60
}

run_case agents_md_of_200_lines fail "error: src/AGENTS.md has 200 lines, and the limit is 199."
run_case agents_md_of_200_lines fail "the limit is 199. Move a procedure that only one kind of request needs into a guide of its own, as docs/rules.md describes."
run_case agents_md_of_199_lines pass
run_case guide_of_25000_bytes fail "error: docs/writing.md has 25000 bytes, and the limit is 24999."
run_case guide_of_24999_bytes pass
run_case long_page_that_is_no_guide pass
run_case agents_md_files_of_32000_bytes_on_one_path fail "error: the AGENTS.md files from the root down to src/api have 32000 bytes together, and the limit is 31999."
run_case agents_md_files_of_32000_bytes_on_two_paths pass

# Cases for the check that finds section names that match no heading.

section_names_in_files_without_those_headings() {
  echo '# Target' > "$copy/docs/target.md"
  cat > "$copy/docs/notes.md" <<'EOF'
See "Target" in docs/target.md, and "No such section" in docs/target.md.
See "No such section" in `docs/target.md`.
See "No such section" in [docs/target.md](target.md).
EOF
}

section_name_with_describes_that_matches_no_heading() {
  printf '%s\n' '# Notes' 'Do it as "No such section" describes.' > "$copy/docs/notes.md"
}

section_name_with_says_that_matches_no_heading_or_field() {
  printf '%s\n' '# Notes' 'Do what "No such section" says.' > "$copy/docs/notes.md"
}

section_name_in_a_file_that_doesnt_exist() {
  echo 'See "Target" in docs/gone.md.' > "$copy/docs/notes.md"
}

form_field_named_with_says() {
  printf '%s\n' 'body:' '  - type: textarea' '    attributes:' '      label: Who needs it' > "$copy/.github/ISSUE_TEMPLATE/idea.yml"
  echo 'Write what "Who needs it" says.' > "$copy/docs/notes.md"
}

section_names_that_match_headings() {
  printf '%s\n' '# Target' '### Section at level 3' > "$copy/docs/target.md"
  cat > "$copy/docs/notes.md" <<'EOF'
# Notes
See "Section at level 3" in docs/target.md, and "Target" in `docs/target.md`.
See "Target" in [docs/target.md](target.md), as "Notes" describes.
Put "read `docs/target.md` first" in each prompt.
EOF
}

run_case section_names_in_files_without_those_headings fail 'error: docs/notes.md:1 names "No such section" in docs/target.md, which has no such heading. Fix the name, or the heading.'
run_case section_names_in_files_without_those_headings fail 'error: docs/notes.md:2 names "No such section" in docs/target.md, which has no such heading.'
run_case section_names_in_files_without_those_headings fail 'error: docs/notes.md:3 names "No such section" in docs/target.md, which has no such heading.'
run_case section_name_with_describes_that_matches_no_heading fail 'error: docs/notes.md:2 names "No such section", which matches no heading in docs/notes.md and no field label in .github/ISSUE_TEMPLATE/. Fix the name, or the heading.'
run_case section_name_with_says_that_matches_no_heading_or_field fail 'error: docs/notes.md:2 names "No such section", which matches no heading in docs/notes.md and no field label in .github/ISSUE_TEMPLATE/.'
run_case section_name_in_a_file_that_doesnt_exist fail "error: docs/notes.md:1 names \"Target\" in docs/gone.md, which doesn't exist. Write the path from the repository's root to the file."
run_case form_field_named_with_says pass
run_case section_names_that_match_headings pass

# Case for the place where setup adds the project's checks, which the copies skip.

# The last line of the comment in scripts/check that marks the place.
project_checks_comment="# Keep this comment after setup, because a case in scripts/test-check finds the place by it."

# Puts a command that fails right after the comment.
project_check_that_fails() {
  local line found_comment=""
  local -a lines=()
  while IFS= read -r line; do
    lines+=("$line")
    if [[ $line == *"$project_checks_comment"* ]]; then
      lines+=(false)
      found_comment=yes
    fi
  done < "$copy/scripts/check"
  if [[ -z "$found_comment" ]]; then
    echo "error: in the case project_check_that_fails, can't find the line \"$project_checks_comment\" in scripts/check. Put the comment that ends with this line back at the top of the block that runs only when CHECK_UNDER_TEST is unset." >&2
    exit 1
  fi
  printf '%s\n' "${lines[@]}" > "$copy/scripts/check"
}

run_case project_check_that_fails pass

# Cases for the check that the files agree on the facts that they repeat.

# Replaces each copy of a text in a file of the copy: replace_text <file> <text> <new text>
# Stops the tests if the file doesn't hold the text, because the case would then test nothing.
replace_text() {
  local file=$1 text=$2 new_text=$3 content replaced=""
  content=$(<"$copy/$file")
  if [[ $content != *"$text"* ]]; then
    echo "error: in the case ${FUNCNAME[1]}, can't find \"$text\" in $file. Change the case to match the file." >&2
    exit 1
  fi
  while [[ $content == *"$text"* ]]; do
    replaced+=${content%%"$text"*}$new_text
    content=${content#*"$text"}
  done
  printf '%s\n' "$replaced$content" > "$copy/$file"
}

label_that_configure_github_doesnt_create() {
  replace_text AGENTS.md "## Labels" $'## Labels\n\nClose an issue that no one will build with `wontfix`.'
}

label_that_agents_md_doesnt_name() {
  replace_text scripts/configure-github "<<'LABELS'" "<<'LABELS'"$'\n'"wontfix|ffffff|No one will build this"
}

dependabot_label_that_agents_md_doesnt_name() {
  replace_text .github/dependabot.yml "labels: [dependencies]" "labels: [deps]"
}

labels_in_a_block_list() {
  replace_text .github/release.yml "labels: [bug]" $'labels:\n        - bug'
}

unknown_label_in_a_block_list() {
  replace_text .github/release.yml "labels: [bug]" $'labels:\n        - bug\n        - "regression"'
}

unknown_label_in_a_string_with_commas() {
  replace_text .github/ISSUE_TEMPLATE/bug.yml "labels: [bug, needs-triage]" "labels: bug, wontfix"
}

star_label_outside_release_notes() {
  replace_text .github/dependabot.yml "labels: [dependencies]" 'labels: ["*"]'
}

# Renames the section, and the names that quote it, so that the check of section names still passes.
agents_md_without_labels() {
  replace_text AGENTS.md "## Labels" "## Label rules"
  replace_text AGENTS.md '"Labels"' '"Label rules"'
  replace_text docs/rules.md '"Labels"' '"Label rules"'
}

run_case label_that_configure_github_doesnt_create fail "error: \"Labels\" in AGENTS.md names wontfix, and scripts/configure-github doesn't create it. Add it to scripts/configure-github, or remove it from AGENTS.md."
run_case label_that_agents_md_doesnt_name fail "error: scripts/configure-github creates the label wontfix, and \"Labels\" in AGENTS.md doesn't name it. Add it to AGENTS.md, or remove it from scripts/configure-github."
run_case dependabot_label_that_agents_md_doesnt_name fail "error: .github/dependabot.yml names the label deps, and \"Labels\" in AGENTS.md doesn't name it. Use a label that AGENTS.md names, or add deps to AGENTS.md and scripts/configure-github."
run_case labels_in_a_block_list pass
run_case unknown_label_in_a_block_list fail "error: .github/release.yml names the label regression, and \"Labels\" in AGENTS.md doesn't name it."
run_case unknown_label_in_a_string_with_commas fail "error: .github/ISSUE_TEMPLATE/bug.yml names the label wontfix, and \"Labels\" in AGENTS.md doesn't name it."
run_case star_label_outside_release_notes fail "error: .github/dependabot.yml names the label *, and \"Labels\" in AGENTS.md doesn't name it."
run_case agents_md_without_labels fail "error: AGENTS.md has no section \"Labels\", and scripts/check compares that section with other files. Add it, with the heading \"## Labels\"."

title_check_without_a_type() {
  replace_text .github/workflows/pr-title.yml "|perf|" "|"
}

title_check_with_an_extra_type() {
  replace_text .github/workflows/pr-title.yml "|chore\"" "|chore|wip\""
}

run_case title_check_without_a_type fail "error: \"Commits\" in AGENTS.md lists the type perf, and the title check in .github/workflows/pr-title.yml doesn't allow it. Add it to the types in .github/workflows/pr-title.yml, or remove it from AGENTS.md."
run_case title_check_with_an_extra_type fail "error: the title check in .github/workflows/pr-title.yml allows the type wip, and \"Commits\" in AGENTS.md doesn't list it. Add it to AGENTS.md, or remove it from the types in .github/workflows/pr-title.yml."

# Writes .github/workflows/lint.yml, with one job that has a step named lint: write_workflow <event> <job key> [<job name>]
write_workflow() {
  local event=$1 key=$2 name=${3:-}
  {
    printf '%s\n' "name: Lint" "on: $event" "permissions: {}" "jobs:" "  $key:"
    if [[ -n $name ]]; then
      printf '%s\n' "    name: $name"
    fi
    printf '%s\n' "    runs-on: ubuntu-latest" "    steps:" "      - name: lint" "        run: echo \"The style is fine.\""
  } > "$copy/.github/workflows/lint.yml"
}

required_check_that_no_job_reports() {
  replace_text scripts/configure-github '"context": "check"' '"context": "lint"'
}

required_check_from_a_job_name() {
  replace_text scripts/configure-github '"context": "check"' '"context": "lint"'
  write_workflow "[push, pull_request]" style lint
}

required_check_from_a_step_name() {
  replace_text scripts/configure-github '"context": "check"' '"context": "lint"'
  write_workflow pull_request style
}

required_check_from_a_workflow_that_doesnt_run_on_pull_requests() {
  replace_text scripts/configure-github '"context": "check"' '"context": "lint"'
  write_workflow pull_request_review lint
}

run_case required_check_that_no_job_reports fail "error: scripts/configure-github requires the check lint on main, and no job in a workflow in .github/workflows that runs on pull_request reports it. The jobs in those workflows report: check, title, label. Rename a job to lint, or change the check in scripts/configure-github."
run_case required_check_from_a_job_name pass
run_case required_check_from_a_step_name fail "error: scripts/configure-github requires the check lint on main, and no job in a workflow in .github/workflows that runs on pull_request reports it."
run_case required_check_from_a_workflow_that_doesnt_run_on_pull_requests fail "error: scripts/configure-github requires the check lint on main, and no job in a workflow in .github/workflows that runs on pull_request reports it."

hook_that_asks_for_another_gh_version() {
  replace_text scripts/hooks/session-start "minimum_gh_minor=98" "minimum_gh_minor=99"
}

readme_that_asks_for_another_gh_version() {
  replace_text README.md "The GitHub CLI 2.98 or later" "The GitHub CLI 2.97 or later"
}

agents_md_without_the_gh_version() {
  replace_text AGENTS.md "need gh 2.98 or later" "need a recent gh"
}

hook_without_the_gh_version() {
  replace_text scripts/hooks/session-start "minimum_gh_minor" "needed_gh_minor"
}

readme_of_a_new_project() {
  printf '%s\n' "# expense-tracker" "" "Records what you spend. It can't do anything yet." > "$copy/README.md"
}

run_case hook_that_asks_for_another_gh_version fail "error: scripts/hooks/session-start asks for gh 2.99, and AGENTS.md says gh 2.98. Use the same version in both."
run_case readme_that_asks_for_another_gh_version fail "error: README.md asks for the GitHub CLI 2.97, and AGENTS.md says gh 2.98. Use the same version in both."
run_case agents_md_without_the_gh_version fail "error: AGENTS.md doesn't name the gh version that the rules need, written as \"gh <version> or later\"."
run_case hook_without_the_gh_version fail "error: scripts/hooks/session-start doesn't set both minimum_gh_major and minimum_gh_minor, so it can't ask for gh 2.98, as AGENTS.md does."
run_case readme_of_a_new_project pass

guide_in_neither_list() {
  printf '%s\n' "# Notes guide" "" "Ideas for later." > "$copy/docs/notes.md"
}

page_whose_title_doesnt_end_in_guide() {
  printf '%s\n' "# Notes" "" "Ideas for later." > "$copy/docs/notes.md"
}

missing_page_in_what_you_get() {
  replace_text README.md "## What you get" $'## What you get\n\n- `docs/missing.md`: a page that doesn\'t exist.'
}

missing_page_in_read_the_guides() {
  replace_text AGENTS.md "- [docs/writing.md](docs/writing.md)," "- [docs/missing.md](docs/missing.md) and [docs/writing.md](docs/writing.md),"
}

run_case guide_in_neither_list fail "error: \"Read the guides\" in AGENTS.md doesn't link to docs/notes.md, which is a guide because its title ends in \"guide\". Link to it there, and say when to read it."
run_case guide_in_neither_list fail "error: \"What you get\" in README.md doesn't name docs/notes.md, which is a guide because its title ends in \"guide\". Name it there, and say what it covers."
run_case page_whose_title_doesnt_end_in_guide pass
run_case missing_page_in_what_you_get fail "error: \"What you get\" in README.md names docs/missing.md, which doesn't exist. Fix the path, or remove it from README.md."
run_case missing_page_in_read_the_guides fail "error: \"Read the guides\" in AGENTS.md links to docs/missing.md, which doesn't exist. Fix the link, or remove it from AGENTS.md."

# Add a case for each check in scripts/check here.

if ((failed_cases > 0)); then
  echo "error: $failed_cases of the $case_count cases in scripts/test-check failed. The errors above say which." >&2
  exit 1
fi
echo "scripts/test-check passed. Cases: $case_count."
