#!/usr/bin/env bash
# Tests scripts/check. Each case runs it on a copy of the repository. scripts/check runs this script.
set -euo pipefail
cd "$(dirname "$0")/.."

copy=""
failed_cases=0
case_count=0

remove_copy() {
  if [[ -n "$copy" ]]; then
    rm -rf "$copy"
  fi
}
trap remove_copy EXIT

# Copies the tracked files, as they are on disk, into a new git repository at $copy.
make_copy() {
  remove_copy
  copy=$(mktemp -d)
  # -f skips the submodules and deleted files that git ls-files also lists.
  git ls-files -z | while IFS= read -r -d '' file; do
    if [[ -f $file ]]; then
      mkdir -p "$copy/$(dirname "$file")"
      cp -p "$file" "$copy/$file"
    fi
  done
  git -C "$copy" init --quiet
}

# Runs one case: run_case <function> <pass or fail> [<text that the output must hold>]
# The function gets a fresh copy at $copy, and adds the files that the case needs to it.
# Use only checks that need no extra tool, so that a case gives the same result on every machine.
run_case() {
  local case_function=$1 expected=$2 expected_text=${3:-}
  local output actual=pass
  case_count=$((case_count + 1))
  make_copy
  "$case_function"
  git -C "$copy" add --all
  # CHECK_UNDER_TEST stops the copy's scripts/check from running this script again.
  if ! output=$(cd "$copy" && CHECK_UNDER_TEST=1 scripts/check 2>&1); then
    actual=fail
  fi

  if [[ $actual != "$expected" ]]; then
    echo "error: in the case $case_function, scripts/check must $expected, but the result was: $actual. Its output:" >&2
    printf '%s\n' "$output" >&2
    failed_cases=$((failed_cases + 1))
    return
  fi
  if [[ -n "$expected_text" && "$output" != *"$expected_text"* ]]; then
    echo "error: in the case $case_function, the output of scripts/check must hold \"$expected_text\". Its output:" >&2
    printf '%s\n' "$output" >&2
    failed_cases=$((failed_cases + 1))
  fi
}

repository_as_it_is() {
  :
}

run_case repository_as_it_is pass

# Cases for the check that finds files that make a tool skip AGENTS.md.

claude_md_in_the_root() {
  echo "Rules" > "$copy/CLAUDE.md"
}

claude_md_in_a_folder_in_lower_case() {
  echo "Rules" > "$copy/docs/claude.md"
}

file_in_a_clinerules_folder() {
  mkdir "$copy/.clinerules"
  echo "Rules" > "$copy/.clinerules/style.md"
}

two_instruction_files() {
  echo "Rules" > "$copy/.cursorrules"
  echo "Rules" > "$copy/AGENTS.override.md"
}

root_only_name_in_a_folder() {
  echo "Notes" > "$copy/docs/AGENT.md"
}

run_case claude_md_in_the_root fail "error: CLAUDE.md makes a tool skip AGENTS.md."
run_case claude_md_in_a_folder_in_lower_case fail "error: docs/claude.md makes a tool skip AGENTS.md."
run_case file_in_a_clinerules_folder fail "error: .clinerules/style.md makes a tool skip AGENTS.md."
run_case two_instruction_files fail "error: .cursorrules makes a tool skip AGENTS.md."
run_case two_instruction_files fail "error: AGENTS.override.md makes a tool skip AGENTS.md."
run_case root_only_name_in_a_folder pass

# Cases for the check that finds notes about unfinished work.
# The two words are split here, so that the check doesn't match this file.
todo="TO""DO"
fixme="FIX""ME"

todo_in_a_shell_script() {
  printf '%s\n' '#!/usr/bin/env bash' 'echo "start"' "# $todo: print the total" > "$copy/scripts/unfinished"
}

fixme_in_a_text_file() {
  echo "$fixme the rounding" > "$copy/notes.txt"
}

other_words_and_markdown() {
  echo "todo, ${todo}S and MY_$todo are other words" > "$copy/notes.txt"
  echo "$todo: write this page" > "$copy/docs/page.md"
}

run_case todo_in_a_shell_script fail "scripts/unfinished:3:# $todo: print the total"
run_case todo_in_a_shell_script fail "error: the lines above hold $todo or $fixme."
run_case fixme_in_a_text_file fail "notes.txt:1:$fixme the rounding"
run_case other_words_and_markdown pass

# Add a case for each check in scripts/check here.

if ((failed_cases > 0)); then
  echo "error: $failed_cases of the $case_count cases in scripts/test-check failed. The errors above say which." >&2
  exit 1
fi
echo "scripts/test-check passed. Cases: $case_count."
