#!/usr/bin/env bash
# Runs a rule's trial, as "Try a rule on agents" in docs/rules.md describes:
# scripts/try-rule --model <model> <commit> <patch> <prompt file>
# It makes two branches from the commit, each with origin/main's AGENTS.md files and guides in place of the
# commit's own, and applies the patch to one of them. Then it runs the prompt with Claude Code 10 times on each
# branch, all 20 runs at once, and prints each run's branch, time and tokens. It keeps the output of each run.
set -euo pipefail

runs_per_branch=10
run_count=$((2 * runs_per_branch))
# Each run gets this after the prompt, so that no run changes GitHub.
github_request="Don't run any command that changes GitHub, such as git push, gh pr create or gh issue comment. Say what you would run instead."
# Both branches get one commit with this message, so that the history doesn't show which branch a run has.
commit_message="docs: update AGENTS.md and the guides"

# Prints an error and stops: stop <message>
stop() {
  echo "error: $1" >&2
  exit 1
}

if (($# != 5)) || [[ $1 != --model ]]; then
  stop "scripts/try-rule takes these arguments, in this order: --model <model> <commit> <patch> <prompt file>. For example: scripts/try-rule --model claude-opus-5-5 1a2b3c4 rule.patch prompt.md"
fi
model=$2 commit=$3 patch=$4 prompt_file=$5
if [[ ! -f $patch ]]; then
  stop "can't find the patch $patch. Pass the path of a file that holds the rule as a patch to main's AGENTS.md and guides."
fi
if [[ ! -f $prompt_file ]]; then
  stop "can't find the prompt file $prompt_file. Pass the path of a file that holds the prompt."
fi
# The paths are relative to the folder that the script starts in, so it reads them before it changes folder.
patch_path=$(cd "$(dirname "$patch")" && pwd -P)/$(basename "$patch")
prompt=$(<"$prompt_file")
cd "$(dirname "$0")/.."
# shellcheck source=scripts/guides
source scripts/guides

if ! command -v jq >/dev/null; then
  stop "scripts/try-rule needs jq to read the output of the runs. Install it: https://jqlang.org/download/"
fi
if ! claude=$(command -v claude); then
  stop "can't find claude, the command that starts Claude Code, on the PATH. Install Claude Code, and run scripts/try-rule again."
fi
# Every run starts the file that claude links to, and turns off its own updates with DISABLE_AUTOUPDATER,
# so that an update during the trial can't give the runs different versions.
while [[ -L $claude ]]; do
  link=$(readlink "$claude")
  if [[ $link != /* ]]; then
    link=$(dirname "$claude")/$link
  fi
  claude=$link
done
version=$("$claude" --version)
version=${version%% *}

if ! git fetch --quiet origin main; then
  stop "can't fetch main from origin, as git says above. Check the network and the remote, and run scripts/try-rule again."
fi
if ! commit_sha=$(git rev-parse --verify --quiet "$commit^{commit}"); then
  stop "this repository has no commit $commit. Pass a commit from before the task is done."
fi
main_sha=$(git rev-parse origin/main)

scratch=$(mktemp -d)
temporary_folders=("$scratch")
trap 'rm -rf "${temporary_folders[@]}"' EXIT

# A clone from a folder takes every object of this repository, so it has the commit and main even when no branch
# points to them.
branches=$scratch/branches
git clone --quiet --no-checkout . "$branches"

# Puts main's AGENTS.md files and guides in place of the checked-out commit's own, and stages them.
# Run it in the clone's root, where linked_guides reads AGENTS.md.
use_main_rules() {
  local guide
  while IFS= read -r guide; do
    git rm --quiet --ignore-unmatch -- "$guide"
  done < <(linked_guides)
  git rm --quiet --ignore-unmatch -- ':(glob)**/AGENTS.md'
  git checkout --quiet "$main_sha" -- ':(glob)**/AGENTS.md'
  while IFS= read -r guide; do
    git checkout --quiet "$main_sha" -- "$guide"
  done < <(linked_guides)
}

git -C "$branches" checkout --quiet -b without-rule "$commit_sha"
(cd "$branches" && use_main_rules)
git -C "$branches" commit --quiet --allow-empty -m "$commit_message"
git -C "$branches" checkout --quiet -b with-rule
if ! git -C "$branches" apply --index "$patch_path"; then
  stop "the patch $patch doesn't apply to the AGENTS.md files and guides of origin/main, as git says above. Write the patch against them, such as with git diff origin/main."
fi
git -C "$branches" commit --quiet --amend --no-edit --allow-empty

# Makes a clone of a branch with no remote, on a branch named main. git init and git fetch make it instead of
# git clone, which would name the branch in the clone's settings. The fetch and the reflogs name it too, so the
# function removes them: make_clone <branch> <folder>
make_clone() {
  local branch=$1 clone=$2
  git init --quiet --initial-branch=main "$clone"
  git -C "$clone" fetch --quiet "$branches" "refs/heads/$branch"
  git -C "$clone" reset --quiet --hard FETCH_HEAD
  rm -rf "$clone/.git/FETCH_HEAD" "$clone/.git/logs"
}

# Each run works in a folder whose name doesn't show its branch. The folder holds the clone, which has the
# repository's name, and a temporary folder of the run's own. The runs with the rule come first.
name=$(basename "$PWD")
run_branches=()
run_folders=()
for ((run = 1; run <= run_count; run++)); do
  branch=with-rule
  if ((run > runs_per_branch)); then
    branch=without-rule
  fi
  folder=$(mktemp -d)
  temporary_folders+=("$folder")
  make_clone "$branch" "$folder/$name"
  mkdir "$folder/tmp"
  run_branches+=("$branch")
  run_folders+=("$folder")
done

temporary_root=${TMPDIR:-/tmp}
trial=$(mktemp -d "${temporary_root%/}/try-rule.XXXXXX")
# Prints the path of a run's output, without the extension: output_of <run>
output_of() {
  printf '%s/run-%02d\n' "$trial" "$1"
}

pids=()
for ((run = 1; run <= run_count; run++)); do
  folder=${run_folders[run - 1]}
  (
    cd "$folder/$name"
    TMPDIR=$folder/tmp CLAUDE_CODE_TMPDIR=$folder/tmp DISABLE_AUTOUPDATER=1 "$claude" --model "$model" \
      --permission-mode auto --output-format stream-json --verbose -p "$prompt"$'\n\n'"$github_request"
  ) </dev/null >"$(output_of "$run").jsonl" 2>"$(output_of "$run").err" &
  pids+=("$!")
done
echo "Started $run_count runs, $runs_per_branch with the rule and $runs_per_branch without it. Their output goes to $trial."

statuses=()
for pid in "${pids[@]}"; do
  status=0
  wait "$pid" || status=$?
  statuses+=("$status")
done

# Prints a run's time in seconds, its tokens and its output tokens, separated by tabs, from the result at the end
# of its output, or nothing if the output has no result. The tokens count every model that the run used,
# including its subagents, which modelUsage counts and usage doesn't: result_of <output file>
result_of() {
  jq -nr '[inputs | select(.type == "result")] | last | select(. != null)
    | [(.duration_ms / 1000 | floor),
      ([.modelUsage[] | .inputTokens + .cacheCreationInputTokens + .cacheReadInputTokens + .outputTokens] | add // 0),
      ([.modelUsage[] | .outputTokens] | add // 0)]
    | @tsv' "$1"
}

# Prints a number with a comma between each group of three digits, as in 2,550,274: with_commas <number>
with_commas() {
  local number=$1 grouped=""
  while ((${#number} > 3)); do
    grouped=,${number: -3}$grouped
    number=${number:0:${#number}-3}
  done
  printf '%s\n' "$number$grouped"
}

echo
echo "Claude Code $version, model $model, in auto mode"
echo
echo "| Run | Branch | Time | Tokens | Output tokens |"
echo "|---|---|---|---|---|"
run_errors=""
for ((run = 1; run <= run_count; run++)); do
  output=$(output_of "$run")
  branch="with the rule"
  if [[ ${run_branches[run - 1]} == without-rule ]]; then
    branch="without the rule"
  fi
  time="" tokens="" output_tokens=""
  result=$(result_of "$output.jsonl") || result=""
  if [[ -n $result ]]; then
    IFS=$'\t' read -r seconds tokens output_tokens <<<"$result"
    time=$(printf '%d min %02d s' $((seconds / 60)) $((seconds % 60)))
    tokens=$(with_commas "$tokens")
    output_tokens=$(with_commas "$output_tokens")
  fi
  printf '| %s | %s | %s | %s | %s |\n' "$run" "$branch" "$time" "$tokens" "$output_tokens"

  status=${statuses[run - 1]}
  if ((status != 0)); then
    run_errors+="error: run $run exited with code $status. Its errors are in $output.err, and its output in $output.jsonl."$'\n'
  elif [[ -z $result ]]; then
    run_errors+="error: run $run ended without a result, so the table has no time or tokens for it. Its output is in $output.jsonl."$'\n'
  fi
done
if [[ -n $run_errors ]]; then
  printf '%s' "$run_errors" >&2
  exit 1
fi
