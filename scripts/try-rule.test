#!/usr/bin/env bash
# Tests scripts/try-rule on a copy of it in a repository whose commits the test writes, with a stand-in for claude.
set -euo pipefail
cd "$(dirname "$0")/.."

# scripts/try-rule reads the output of the runs with jq. Without jq, scripts/check skips the hooks' tests on your
# machine, and this test is skipped too. CI installs jq.
if ! command -v jq >/dev/null; then
  echo "Skipped scripts/try-rule.test because jq is not installed. To run it here, install it: https://jqlang.org/download/" >&2
  exit 0
fi

case_count=0
failed_cases=0

base=$(cd "$(mktemp -d)" && pwd -P)
trap 'rm -rf "$base"' EXIT
# git looks for no repository above the temporary folder, reads none of the person's settings,
# and commits as a stand-in person.
export GIT_CEILING_DIRECTORIES=$base
export GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_NOSYSTEM=1
export GIT_AUTHOR_NAME=Tester GIT_AUTHOR_EMAIL=tester@example.com
export GIT_COMMITTER_NAME=Tester GIT_COMMITTER_EMAIL=tester@example.com
# The script makes its temporary folders here, so that the test can check which ones it leaves behind.
export TMPDIR=$base/tmp
mkdir "$TMPDIR"

# The output that the stand-in prints for a run with the rule and for a run without it, as claude's stream-json
# prints it. usage counts only the main loop, and modelUsage counts every model, so the table must use modelUsage.
cat >"$base/with-rule.jsonl" <<'OUTPUT'
{"type":"system","subtype":"init","claude_code_version":"2.1.294","model":"test-model"}
{"type":"assistant","message":{"content":[{"type":"text","text":"Done."}]}}
{"type":"result","subtype":"success","is_error":false,"duration_ms":873456,"usage":{"input_tokens":12,"cache_creation_input_tokens":150000,"cache_read_input_tokens":2380000,"output_tokens":19204},"modelUsage":{"test-model":{"inputTokens":12,"outputTokens":19204,"cacheReadInputTokens":2380000,"cacheCreationInputTokens":150000},"test-small-model":{"inputTokens":1000,"outputTokens":58,"cacheReadInputTokens":0,"cacheCreationInputTokens":0}}}
OUTPUT
cat >"$base/without-rule.jsonl" <<'OUTPUT'
{"type":"system","subtype":"init","claude_code_version":"2.1.294","model":"test-model"}
{"type":"result","subtype":"success","is_error":false,"duration_ms":59999,"usage":{"input_tokens":0,"cache_creation_input_tokens":0,"cache_read_input_tokens":999,"output_tokens":1},"modelUsage":{"test-model":{"inputTokens":0,"outputTokens":1,"cacheReadInputTokens":999,"cacheCreationInputTokens":0}}}
OUTPUT

# A stand-in for claude, which bin/claude links to, as the installer of Claude Code links it. It answers --version
# with the name of its file. For a run, it waits up to 10 seconds until all 3 runs of a part have started, and writes
# what it finds in its clone to a new file in TEST_RECORDS, and its clone's and temporary folder's paths to
# TEST_FOLDERS. Then it prints the output for a run with the rule or without it, depending on whether the clone's
# AGENTS.md holds the rule.
# With TEST_FAILURE set to yes, a run with the rule prints no result, and a run without it fails.
mkdir "$base/versions" "$base/bin" "$base/started" "$base/records"
cat >"$base/versions/2.1.294" <<'STAND_IN'
#!/usr/bin/env bash
set -euo pipefail
if [[ $* == --version ]]; then
  echo "$(basename "$0") (Claude Code)"
  exit 0
fi

touch "$TEST_STARTED/$$"
started_together=no
for ((tries = 0; tries < 100; tries++)); do
  if (($(ls "$TEST_STARTED" | wc -l) == 3)); then
    started_together=yes
    break
  fi
  sleep 0.1
done

record=$(mktemp "$TEST_RECORDS/run.XXXXXX")
{
  echo "started with the other runs: $started_together"
  echo "program: $(cd "$(dirname "$0")" && pwd -P)/$(basename "$0")"
  echo "arguments:"
  printf '%s\n' "$@"
  echo "DISABLE_AUTOUPDATER: ${DISABLE_AUTOUPDATER:-unset}"
  if [[ ${TMPDIR:-} == "${CLAUDE_CODE_TMPDIR:-}" && -d $TMPDIR && -z $(ls -A "$TMPDIR") ]]; then
    echo "TMPDIR and CLAUDE_CODE_TMPDIR: the same empty folder"
  fi
  echo "folder: $(basename "$PWD")"
  echo "remotes:"
  git remote
  echo "branches:"
  git branch --format='%(refname:short)'
  echo "reflog:"
  git reflog
  echo "files in .git that name a branch:"
  grep -rIl -e with-rule -e without-rule .git || true
  echo "changes:"
  git status --porcelain
  echo "commits:"
  git log --format=%s
  echo "files:"
  git ls-files
  for file in $(git ls-files); do
    echo "--- $file"
    cat "$file"
  done
} >"$record"
printf '%s\n%s\n' "$PWD" "$TMPDIR" >>"$TEST_FOLDERS"

if grep -q "The new rule." AGENTS.md; then
  if [[ ${TEST_FAILURE:-} == yes ]]; then
    head -n 1 "$TEST_OUTPUTS/with-rule.jsonl"
    exit 0
  fi
  cat "$TEST_OUTPUTS/with-rule.jsonl"
else
  if [[ ${TEST_FAILURE:-} == yes ]]; then
    echo "API Error: 500" >&2
    exit 1
  fi
  cat "$TEST_OUTPUTS/without-rule.jsonl"
fi
STAND_IN
chmod +x "$base/versions/2.1.294"
ln -s ../versions/2.1.294 "$base/bin/claude"
export TEST_STARTED=$base/started TEST_RECORDS=$base/records TEST_FOLDERS=$base/folders TEST_OUTPUTS=$base

# The repository: its first commit, which the trial starts from, has old rules and guides, a page that isn't a guide,
# and a project file. Main on origin then changes all of them. The repository hasn't fetched that change yet,
# so the script has to fetch it.
origin=$base/origin.git
repository=$base/repository
other_clone=$base/other-clone
git init --quiet --bare --initial-branch=main "$origin"
git init --quiet --initial-branch=main "$repository"

# Writes a file of the repository or the other clone, and its folder: write <path> <text>
write() {
  mkdir -p "$(dirname "$1")"
  printf '%s\n' "$2" >"$1"
}

write "$repository/AGENTS.md" "# Rules

Old rule.

## Read the guides

- [docs/old.md](docs/old.md)"
write "$repository/docs/old.md" "# Old guide"
write "$repository/docs/usage.md" "Usage, version 1"
write "$repository/api/AGENTS.md" "Old rule for the API."
write "$repository/app.txt" "Version 1"
git -C "$repository" add --all
git -C "$repository" commit --quiet -m "feat: start the expense tracker"
git -C "$repository" remote add origin "$origin"
git -C "$repository" push --quiet origin main
start_commit=$(git -C "$repository" rev-parse HEAD)

git clone --quiet "$origin" "$other_clone"
write "$other_clone/AGENTS.md" "# Rules

Today's rule.

## Read the guides

- [docs/new.md](docs/new.md)
- [docs/new.md#examples](docs/new.md#examples)"
git -C "$other_clone" rm --quiet docs/old.md api/AGENTS.md
write "$other_clone/docs/new.md" "# New guide"
write "$other_clone/web/AGENTS.md" "Today's rule for the web."
write "$other_clone/docs/usage.md" "Usage, version 2"
write "$other_clone/app.txt" "Version 2"
git -C "$other_clone" add --all
git -C "$other_clone" commit --quiet -m "feat: total each month"
git -C "$other_clone" push --quiet origin main

# The rule, as a patch to main's AGENTS.md, and the prompt, in the folder that the script starts in.
# A patch to the first commit's AGENTS.md, which doesn't apply to main's, is there too.
{
  head -n 3 "$other_clone/AGENTS.md"
  echo "The new rule."
  tail -n +4 "$other_clone/AGENTS.md"
} >"$base/AGENTS.md.with-rule"
cp "$base/AGENTS.md.with-rule" "$other_clone/AGENTS.md"
git -C "$other_clone" diff >"$base/rule.patch"
git -C "$other_clone" checkout --quiet -- AGENTS.md
write "$base/prompt.md" "Build this issue:

Add a total for each month."
write "$base/stale.patch" "--- a/AGENTS.md
+++ b/AGENTS.md
@@ -1,3 +1,3 @@
 # Rules

-Old rule.
+Changed old rule."

mkdir "$repository/scripts"
cp -p scripts/try-rule scripts/guides "$repository/scripts/"
# A repository without the trial's commits, with a copy of the script too
other_repository=$base/other-repository
git init --quiet --initial-branch=main "$other_repository"
mkdir "$other_repository/scripts"
cp -p scripts/try-rule scripts/guides "$other_repository/scripts/"

# What the stand-in finds in the clone of a run: expected_record <with-rule or without-rule>
expected_record() {
  local agents_md
  agents_md=$(<"$other_clone/AGENTS.md")
  if [[ $1 == with-rule ]]; then
    agents_md=$(<"$base/AGENTS.md.with-rule")
  fi
  cat <<RECORD
started with the other runs: yes
program: $base/versions/2.1.294
arguments:
--model
test-model
--permission-mode
auto
--output-format
stream-json
--verbose
-p
Build this issue:

Add a total for each month.

Don't run any command that changes GitHub, such as git push, gh pr create or gh issue comment. Say what you would run instead.
DISABLE_AUTOUPDATER: 1
TMPDIR and CLAUDE_CODE_TMPDIR: the same empty folder
folder: repository
remotes:
branches:
main
reflog:
files in .git that name a branch:
changes:
commits:
docs: update AGENTS.md and the guides
feat: start the expense tracker
files:
AGENTS.md
app.txt
docs/new.md
docs/usage.md
web/AGENTS.md
--- AGENTS.md
$agents_md
--- app.txt
Version 1
--- docs/new.md
# New guide
--- docs/usage.md
Usage, version 1
--- web/AGENTS.md
Today's rule for the web.
RECORD
}

# The copy of the script that run_try_rule runs
try_rule=$repository/scripts/try-rule

# Runs the copy of the script from $base, and sets status, output and errors: run_try_rule [<argument>...]
run_try_rule() {
  rm -rf "${TMPDIR:?}"/* "${TEST_STARTED:?}"/* "${TEST_RECORDS:?}"/* "$TEST_FOLDERS"
  status=0
  output=$(cd "$base" && PATH=$base/bin:$PATH "$try_rule" "$@" 2>"$base/errors") || status=$?
  errors=$(<"$base/errors")
}

# Prints an error for a failed case: fail <description> <what went wrong>
fail() {
  echo "error: $1, $2" >&2
  failed_cases=$((failed_cases + 1))
}

# Prints the folder that the script keeps the output in, or nothing if it kept none.
trial_folder() {
  local folder
  for folder in "$TMPDIR"/try-rule.*; do
    if [[ -d $folder ]]; then
      printf '%s\n' "$folder"
    fi
  done
}

# Moves the folder that the script keeps the output in to a folder of $base, because the next run_try_rule
# removes everything in TMPDIR: keep_trial_folder <name>
keep_trial_folder() {
  mv "$(trial_folder)" "$base/$1"
}

# The table that the script prints after the runs, without the lines before it:
# table <last run> <row of a run without the rule> [<row of a run with the rule>]
table() {
  local last_run=$1 run
  echo "Claude Code 2.1.294, model test-model, in auto mode"
  echo
  echo "| Run | Branch | Time | Tokens | Output tokens |"
  echo "|---|---|---|---|---|"
  for ((run = 1; run <= last_run; run++)); do
    if ((run <= 3)); then
      echo "| $run | without the rule | $2 |"
    else
      echo "| $run | with the rule | $3 |"
    fi
  done
}

# Checks that the script ran 3 runs on a branch, each in a clone of its own with the right files, and that it kept
# each run's output in the output folder: expect_runs <description> <with-rule or without-rule> <output folder>
expect_runs() {
  local description=$1 branch=$2 trial=$3 record runs=0 folders leftover="" first_run=1 run output
  case_count=$((case_count + 1))
  for record in "$TEST_RECORDS"/*; do
    if [[ -f $record && $(<"$record") == "$(expected_record "$branch")" ]]; then
      runs=$((runs + 1))
    elif [[ -f $record ]]; then
      echo "A run found this in its clone:" >&2
      cat "$record" >&2
    fi
  done
  if ((runs != 3)); then
    fail "$description" "all 3 runs must find the clone of the branch $branch, but $runs did. What the other runs found is above."
    return
  fi
  folders=$(sort -u "$TEST_FOLDERS" | wc -l)
  if ((folders != 6)); then
    fail "$description" "each of the 3 runs must have a clone and a temporary folder of its own, but they had $folders folders: $(<"$TEST_FOLDERS")"
    return
  fi
  if [[ $(dirname "$trial") == "$TMPDIR" ]]; then
    leftover=$(basename "$trial")
  fi
  if [[ $(ls "$TMPDIR") != "$leftover" ]]; then
    fail "$description" "scripts/try-rule must remove the clones and temporary folders, and keep only the folder with the output, but it left: $(ls "$TMPDIR")"
    return
  fi
  if [[ $branch == with-rule ]]; then
    first_run=4
  fi
  for ((run = first_run; run < first_run + 3; run++)); do
    output=$trial/$(printf 'run-%02d' "$run").jsonl
    if ! cmp -s "$output" "$base/$branch.jsonl"; then
      fail "$description" "scripts/try-rule must keep the output of run $run, the stand-in's output for a run $branch, in $output."
      return
    fi
  done
}

# Checks the script's exit code, output and errors: expect_result <description> <exit code> <output> <errors>
expect_result() {
  local description=$1 expected_status=$2 expected_output=$3 expected_errors=$4
  case_count=$((case_count + 1))
  if [[ $status != "$expected_status" || $output != "$expected_output" || $errors != "$expected_errors" ]]; then
    fail "$description" "scripts/try-rule must exit with code $expected_status, print \"$expected_output\" and report \"$expected_errors\", but it exited with code $status, printed \"$output\" and reported \"$errors\"."
  fi
}

# Checks that the script stopped with an error before it started any run, and left no folder behind:
# expect_stop <description> <error>
expect_stop() {
  local description=$1 error=$2
  expect_result "$description" 1 "" "$error"
  case_count=$((case_count + 1))
  if [[ -n $(ls "$TEST_STARTED") || -n $(ls "$TMPDIR") ]]; then
    fail "$description" "scripts/try-rule must start no run and leave no folder, but it started the runs with these process IDs: $(ls "$TEST_STARTED"), and left: $(ls "$TMPDIR")"
  fi
}

# The line that the script prints when it starts the runs: started_line <with or without> <output folder>
started_line() {
  echo "Started 3 runs $1 the rule. Their output goes to $2."
}

# The errors that the script reports for 3 runs that failed, from the first: failed_runs <first run> <output folder>
failed_runs() {
  local run file
  for ((run = $1; run < $1 + 3; run++)); do
    file=$2/$(printf 'run-%02d' "$run")
    if ((run <= 3)); then
      echo "error: run $run exited with code 1. Its errors are in $file.err, and its output in $file.jsonl."
    else
      echo "error: run $run ended without a result, so the table has no time or tokens for it. Its output is in $file.jsonl."
    fi
  done
}

without_rule_row="0 min 59 s | 1,000 | 1"
with_rule_row="14 min 33 s | 2,550,274 | 19,262"

# The runs without the rule, with the patch and the prompt given as paths from the folder that the script starts in
run_try_rule --model test-model "$start_commit" rule.patch prompt.md
expect_runs "In the runs without the rule" without-rule "$(trial_folder)"
expect_result "In the runs without the rule" 0 "$(started_line without "$(trial_folder)")"$'\n\n'"$(table 3 "$without_rule_row")"$'\n\n'"To run the prompt 3 times with the rule, run: scripts/try-rule --with-rule $(trial_folder)" ""
keep_trial_folder trial

# The runs with the rule, after main on origin changed a guide, the repository fetched that change, and claude on the
# PATH changed to another version. The runs must still get the main and the version of the runs without the rule.
cp -p "$base/versions/2.1.294" "$base/versions/2.1.295"
ln -sf ../versions/2.1.295 "$base/bin/claude"
write "$other_clone/docs/new.md" "# Newer guide"
git -C "$other_clone" commit --quiet --all -m "docs: retitle the guide"
git -C "$other_clone" push --quiet origin main
git -C "$repository" fetch --quiet origin main
run_try_rule --with-rule trial
ln -sf ../versions/2.1.294 "$base/bin/claude"
expect_runs "In the runs with the rule" with-rule "$base/trial"
expect_result "In the runs with the rule" 0 "$(started_line with "$base/trial")"$'\n\n'"$(table 6 "$without_rule_row" "$with_rule_row")" ""

# Runs with the rule that fail, with the folder given as a full path. They print no result.
TEST_FAILURE=yes run_try_rule --with-rule "$base/trial"
expect_result "In runs with the rule that fail" 1 "$(started_line with "$base/trial")"$'\n\n'"$(table 6 "$without_rule_row" " |  | ")" \
  "$(failed_runs 4 "$base/trial")"

# Runs without the rule that fail, with the patch and the prompt given as full paths. They exit with code 1.
# The script prints no command for the runs with the rule, which then don't start.
TEST_FAILURE=yes run_try_rule --model test-model "$start_commit" "$base/rule.patch" "$base/prompt.md"
expect_result "In runs without the rule that fail" 1 "$(started_line without "$(trial_folder)")"$'\n\n'"$(table 3 " |  | ")" \
  "$(failed_runs 1 "$(trial_folder)")"
keep_trial_folder failed-trial
run_try_rule --with-rule failed-trial
expect_stop "With the folder of runs without the rule that failed" \
  "error: failed-trial doesn't hold 3 runs without the rule that all finished. Run them with scripts/try-rule --model, and then run the command that it prints."

# Runs without the rule on a version of Claude Code that is gone before the runs with the rule
cp -p "$base/versions/2.1.294" "$base/versions/2.1.293"
ln -sf ../versions/2.1.293 "$base/bin/claude"
run_try_rule --model test-model "$start_commit" rule.patch prompt.md
keep_trial_folder old-version-trial
rm "$base/versions/2.1.293"
ln -sf ../versions/2.1.294 "$base/bin/claude"
run_try_rule --with-rule old-version-trial
expect_stop "When the version of Claude Code of the runs without the rule is gone" \
  "error: can't find $base/versions/2.1.293, the version of Claude Code that ran the runs without the rule. Start the trial again with scripts/try-rule --model."

# The runs with the rule in a repository that doesn't have the commits of the runs without the rule
try_rule=$other_repository/scripts/try-rule
run_try_rule --with-rule trial
try_rule=$repository/scripts/try-rule
expect_stop "In a repository without the commits of the runs without the rule" \
  "error: this repository has no commit $start_commit, which the runs without the rule used. Run scripts/try-rule --with-rule in the repository that ran them."

# What the script can't use: its arguments, the files, the commit, the patch and origin
usage="error: scripts/try-rule takes these arguments, in this order: --model <model> <commit> <patch> <prompt file>. For example: scripts/try-rule --model claude-opus-5-5 1a2b3c4 rule.patch prompt.md. For the runs with the rule, it takes --with-rule and the output folder of the runs without it."
run_try_rule
expect_stop "With no arguments" "$usage"
run_try_rule "$start_commit" rule.patch prompt.md
expect_stop "Without the model" "$usage"
run_try_rule test-model --model "$start_commit" rule.patch prompt.md
expect_stop "With the model before --model" "$usage"
run_try_rule --with-rule
expect_stop "With --with-rule and no folder" "$usage"
run_try_rule --with-rule trial failed-trial
expect_stop "With --with-rule and two folders" "$usage"
run_try_rule --model test-model "$start_commit" missing.patch prompt.md
expect_stop "With a patch that doesn't exist" \
  "error: can't find the patch missing.patch. Pass the path of a file that holds the rule as a patch to main's AGENTS.md and guides."
run_try_rule --model test-model "$start_commit" rule.patch missing.md
expect_stop "With a prompt file that doesn't exist" \
  "error: can't find the prompt file missing.md. Pass the path of a file that holds the prompt."
run_try_rule --model test-model 0123456789abcdef0123456789abcdef01234567 rule.patch prompt.md
expect_stop "With a commit that the repository doesn't have" \
  "error: this repository has no commit 0123456789abcdef0123456789abcdef01234567. Pass a commit from before the task is done."
# git reports its own error first, in words that can change from one version of git to the next,
# so these cases check only the script's error, on the last line.
run_try_rule --model test-model "$start_commit" stale.patch prompt.md
errors=${errors##*$'\n'}
expect_stop "With a patch that doesn't apply to main's AGENTS.md" \
  "error: the patch stale.patch doesn't apply to the AGENTS.md files and guides of origin/main, as git says above. Write the patch against them, such as with git diff origin/main."
git -C "$repository" remote set-url origin "$base/missing.git"
run_try_rule --model test-model "$start_commit" rule.patch prompt.md
git -C "$repository" remote set-url origin "$origin"
errors=${errors##*$'\n'}
expect_stop "When git can't fetch main from origin" \
  "error: can't fetch main from origin, as git says above. Check the network and the remote, and run scripts/try-rule again."

if ((failed_cases > 0)); then
  echo "error: $failed_cases of the $case_count cases in scripts/try-rule.test failed. The errors above say which." >&2
  exit 1
fi
echo "scripts/try-rule.test passed. Cases: $case_count."
